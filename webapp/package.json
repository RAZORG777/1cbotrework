{
  "name": "yasno-webapp",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode telegram",
    "build": "npm run build:telegram && npm run build:max",
    "build:telegram": "vite build --mode telegram",
    "build:max": "vite build --mode max",
    "preview:telegram": "vite preview --mode telegram --port 4173 --strictPort",
    "preview:max": "vite preview --mode max --port 4174 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.12"
  }
}
