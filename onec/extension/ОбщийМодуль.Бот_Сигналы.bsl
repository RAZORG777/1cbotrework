// Расширение «Бот_Интеграция». Общий модуль Бот_Сигналы (Сервер, не глобальный).
// Отправка сигналов 1С → боты записи. Контракт: docs/onec-contract.md, раздел 2.
// Настройки — константы расширения Бот_*; секреты не хранятся в тексте модуля.

#Область ПрограммныйИнтерфейс

// Истина, если заявку создал бот (ответственный api_bot или примечание бота).
Функция ЭтоЗаявкаБота(Ответственный, Примечание) Экспорт
	ПользовательБота = Справочники.Пользователи.НайтиПоНаименованию("api_bot");
	Если ЗначениеЗаполнено(ПользовательБота) И Ответственный = ПользовательБота Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = Строка(Примечание);
	Возврат СтрНайти(Текст, "Запись из Telegram") > 0
		Или СтрНайти(Текст, "Запись из MAX") > 0
		Или СтрНайти(Текст, "Перенос из Telegram") > 0
		Или СтрНайти(Текст, "Перенос из MAX") > 0;
КонецФункции

Процедура ОтправитьОтмену(Заявка) Экспорт
	ЗапуститьОтправку("cancel-visit", Заявка);
КонецПроцедуры

Процедура ОтправитьЗавершение(Заявка) Экспорт
	ЗапуститьОтправку("finish-visit", Заявка);
КонецПроцедуры

// Вызывается фоновым заданием. Отправляет сигнал обоим ботам; ошибки — только в журнал регистрации.
Процедура ОтправитьВоВсеБоты(ВидСигнала, ИдентификаторЗаявки) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Адрес = СокрЛП(Константы.Бот_Адрес.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "127.0.0.1";
	КонецЕсли;
	Отправить(Адрес, Константы.Бот_ПортTelegram.Получить(), "/api/v1/internal/" + ВидСигнала,
		Константы.Бот_СекретTelegram.Получить(), ИдентификаторЗаявки, "Telegram");
	Отправить(Адрес, Константы.Бот_ПортMAX.Получить(), "/max/api/v1/internal/" + ВидСигнала,
		Константы.Бот_СекретMAX.Получить(), ИдентификаторЗаявки, "MAX");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапуститьОтправку(ВидСигнала, Заявка)
	УстановитьПривилегированныйРежим(Истина);
	Если Не Константы.Бот_Включено.Получить() Или Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат;
	КонецЕсли;
	Идентификатор = Строка(Заявка.УникальныйИдентификатор());
	Параметры = Новый Массив;
	Параметры.Добавить(ВидСигнала);
	Параметры.Добавить(Идентификатор);
	Попытка
		// Фоновое задание: сохранение документа не ждёт ответа ботов.
		ФоновыеЗадания.Выполнить("Бот_Сигналы.ОтправитьВоВсеБоты", Параметры, ,
			"Сигнал ботам записи: " + ВидСигнала);
	Исключение
		// Фоновые задания недоступны — отправляем сразу (таймаут 5 с, ошибки не прерывают запись).
		ОтправитьВоВсеБоты(ВидСигнала, Идентификатор);
	КонецПопытки;
КонецПроцедуры

Процедура Отправить(Адрес, Порт, Ресурс, Секрет, ИдентификаторЗаявки, ИмяБота)
	Если Не ЗначениеЗаполнено(Порт) Или ПустаяСтрока(Секрет) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Заголовки.Вставить("X-Bot-Secret", Секрет);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Новый Структура("appointment_id", ИдентификаторЗаявки));

		Соединение = Новый HTTPСоединение(Адрес, Порт, , , , 5);
		Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
		Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("Бот.Сигналы", УровеньЖурналаРегистрации.Предупреждение, , ,
				ИмяБота + ": " + Ресурс + " → HTTP " + Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Бот.Сигналы", УровеньЖурналаРегистрации.Ошибка, , ,
			ИмяБота + ": " + Ресурс + " — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
