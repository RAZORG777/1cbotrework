// Расширение «Бот_Интеграция». Заимствованный Документ.Прием, модуль объекта.
// Сигнал finish-visit: проведён приём, созданный из заявки бота (ДокументОснование).
// Повторное проведение безопасно — боты обрабатывают сигнал идемпотентно.

&После("ОбработкаПроведения")
Процедура Бот_ОбработкаПроведения(Отказ, РежимПроведения)
	Если Отказ
		Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.Заявка")
		Или Не ЗначениеЗаполнено(ДокументОснование)
	Тогда
		Возврат;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Ответственный, Примечание");
	Если Бот_Сигналы.ЭтоЗаявкаБота(Реквизиты.Ответственный, Реквизиты.Примечание) Тогда
		Бот_Сигналы.ОтправитьЗавершение(ДокументОснование);
	КонецЕсли;
КонецПроцедуры
