// Расширение «Бот_Интеграция». Заимствованный Документ.Заявка, модуль объекта.
// Сигнал cancel-visit: заявка бота перешла в отменённое состояние или помечена на удаление.
// Срабатывает при любой отмене (из журнала записи, из заявки, пометкой удаления, через HTTP-сервис).

&Перед("ПередЗаписью")
Процедура Бот_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ЭтоНовый() Тогда
		ДополнительныеСвойства.Вставить("Бот_БылаОтменена", Ложь);
		Возврат;
	КонецЕсли;
	Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Состояние, ПометкаУдаления");
	БылаОтменена = Прежние.ПометкаУдаления
		Или УправлениеЗаявками.СостоянияЗаявкиОтменена().Найти(Прежние.Состояние) <> Неопределено;
	ДополнительныеСвойства.Вставить("Бот_БылаОтменена", БылаОтменена);
КонецПроцедуры

&После("ПриЗаписи")
Процедура Бот_ПриЗаписи(Отказ)
	Если Отказ Или Не ДополнительныеСвойства.Свойство("Бот_БылаОтменена") Тогда
		Возврат;
	КонецЕсли;
	ОтмененаСейчас = ПометкаУдаления
		Или УправлениеЗаявками.СостоянияЗаявкиОтменена().Найти(Состояние) <> Неопределено;
	Если ОтмененаСейчас
		И Не ДополнительныеСвойства.Бот_БылаОтменена
		И Бот_Сигналы.ЭтоЗаявкаБота(Ответственный, Примечание)
	Тогда
		Бот_Сигналы.ОтправитьОтмену(Ссылка);
	КонецЕсли;
КонецПроцедуры
