// =========================================================
// 1. СОЗДАНИЕ НОВОЙ ЗАПИСИ (BookPOST)
// Этап 1 (specs/002-patient-emk): пациент ищется или создаётся штатно, с медкартой;
// ошибки — машинным кодом (contracts/onec-book.md).
// =========================================================
Функция BookPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        // ПОДГОТОВКА И ПРОВЕРКА ДАННЫХ (до транзакции)
        Если Не Данные.Свойство("patient") Или Не Данные.Свойство("doctor_id") Тогда
            Возврат ОтветОшибки(Ответ, "BAD_REQUEST", "book: нет patient или doctor_id");
        КонецЕсли;
        Телефон = НормализоватьТелефон(ЗначениеПоля(Данные.patient, "phone"));
        Если ПустаяСтрока(Телефон) Тогда
            Возврат ОтветОшибки(Ответ, "BAD_PHONE", "book: телефон не распознан");
        КонецЕсли;
        ДатаРожд = ПарситьДатуРождения(ЗначениеПоля(Данные.patient, "birth_date"));
        Если ДатаРожд = Неопределено Тогда
            Возврат ОтветОшибки(Ответ, "BAD_BIRTH_DATE", "book: дата рождения не распознана или вне диапазона");
        КонецЕсли;
        Фамилия  = СокрЛП(ЗначениеПоля(Данные.patient, "last_name"));
        Имя      = СокрЛП(ЗначениеПоля(Данные.patient, "first_name"));
        Отчество = СокрЛП(ЗначениеПоля(Данные.patient, "middle_name"));
        Если ПустаяСтрока(Фамилия) Или ПустаяСтрока(Имя) Тогда
            Возврат ОтветОшибки(Ответ, "BAD_REQUEST", "book: нет фамилии или имени");
        КонецЕсли;
        
        Попытка
            СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.doctor_id));
            Начало = ПарситьДату(Данные.date, Данные.time);
            СсылкаУслуга = СсылкаНаУслугу(Данные);
        Исключение
            Возврат ОтветОшибки(Ответ, "BAD_REQUEST", "book: неверный doctor_id, service_id, date или time");
        КонецПопытки;
        
        Окончание = Начало + ДлительностьЗаписи(СсылкаСотрудник, СсылкаУслуга);
        Филиал = Справочники.Филиалы.НайтиПоНаименованию(ЗначениеПоля(Данные, "branch"));
        
        Состояние = СостояниеЗаявкиБота(ЗначениеПоля(Данные, "service_name"));
        Если Не ЗначениеЗаполнено(Состояние) Тогда
            Возврат ОтветОшибки(Ответ, "STATE_NOT_CONFIGURED",
                "book: нет состояния заявки " + ИмяСостоянияБота(ЗначениеПоля(Данные, "service_name")));
        КонецЕсли;
        
        Примечания = Новый Массив;
        Примечания.Добавить(ПримечаниеИсточника(Данные, Ложь, Телефон));
        
        НачатьТранзакцию();
        Попытка
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлок = Блокировка.Добавить("Справочник.Сотрудники");
            ЭлементБлок.УстановитьЗначение("Ссылка", СсылкаСотрудник);
            ЭлементБлок.Режим = РежимБлокировкиДанных.Исключительный;
            // Вся таблица клиентов: параллельные записи одного нового пациента не создают дублей (R4).
            ЭлементКлиенты = Блокировка.Добавить("Справочник.Клиенты");
            ЭлементКлиенты.Режим = РежимБлокировкиДанных.Исключительный;
            Блокировка.Заблокировать(); 
            
            // ПРОВЕРКА ЗАНЯТОСТИ ВРЕМЕНИ
            Если ВремяЗанято(СсылкаСотрудник, Начало, Окончание) Тогда
                ОтменитьТранзакцию(); 
                Возврат ОтветОшибки(Ответ, "SLOT_TAKEN", "");
            КонецЕсли;
            
            // ПОИСК ИЛИ СОЗДАНИЕ ПАЦИЕНТА (R2, R3)
            Поиск = НайтиПациента(Фамилия, Имя, Отчество, ДатаРожд, Телефон);
            Если ЗначениеЗаполнено(Поиск.Клиент) Тогда
                СсылкаКлиент = Поиск.Клиент;
                ИсточникПациента = "found";
                Если Не Поиск.ТелефонСовпал Тогда
                    // Карточку не меняем, телефон — для регистратуры (FR-004).
                    Примечания.Добавить("Телефон из бота: " + Телефон);
                КонецЕсли;
                Если Поиск.Совпадений > 1 Тогда
                    Примечания.Добавить("Проверить пациента: найдено совпадений " + Поиск.Совпадений);
                    ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
                        "Несколько пациентов с одинаковыми ФИО и датой рождения, выбран " + ИдентификаторСсылки(СсылкаКлиент));
                КонецЕсли;
            Иначе
                СсылкаКлиент = СоздатьПациента(Фамилия, Имя, Отчество, ДатаРожд);
                ИсточникПациента = "created";
            КонецЕсли;

            // СОЗДАНИЕ ЗАЯВКИ
            НовыйДок = Документы.Заявка.СоздатьДокумент();
            НовыйДок.Дата = ТекущаяДата();
            НовыйДок.УстановитьНовыйНомер();
            
            Попытка НовыйДок.НесколькоКабинетовИВрачей = Истина; Исключение КонецПопытки;
            Попытка НовыйДок.НесколькоВрачейИКабинетов = Истина; Исключение КонецПопытки;

            НовыйДок.Клиент = СсылкаКлиент;
            НовыйДок.Сотрудник = СсылкаСотрудник;
            НовыйДок.ДатаНачала = Начало;
            НовыйДок.ВремяНачала = Начало;
            НовыйДок.ДатаОкончания = Окончание;
            НовыйДок.ВремяОкончания = Окончание;
            НовыйДок.Филиал = Филиал;
            НовыйДок.Состояние = Состояние;
            
            ОтветственныйПользователь = Справочники.Пользователи.НайтиПоНаименованию("api_bot");
            Если НЕ ОтветственныйПользователь.Пустая() Тогда НовыйДок.Ответственный = ОтветственныйПользователь; КонецЕсли;

            НовыйДок.Примечание = СтрСоединить(Примечания, Символы.ПС);
                        
            ЗаполнитьРаботу(НовыйДок, СсылкаСотрудник, Начало, Окончание, СсылкаУслуга);

            НовыйДок.Записать(РежимЗаписиДокумента.Запись);
            ЗафиксироватьТранзакцию(); 
        Исключение
            ОтменитьТранзакцию(); 
            ВызватьИсключение; 
        КонецПопытки;
        
        // ДОЗАПОЛНЕНИЕ ПАЦИЕНТА — после фиксации: ошибка здесь не срывает запись (FR-006).
        Если ИсточникПациента = "created" Тогда
            ЗаписатьТелефонПациента(СсылкаКлиент, Телефон, НовыйДок.Ссылка);
        КонецЕсли;
        Медкарта = ОбеспечитьМедкарту(СсылкаКлиент, Филиал, НовыйДок.Ссылка);
        
        Результат = Новый Структура("status, appointment_id, patient_id, patient, medical_card",
            "success", ИдентификаторСсылки(НовыйДок.Ссылка), ИдентификаторСсылки(СсылкаКлиент),
            ИсточникПациента, Медкарта);
        
    Исключение
        Возврат ОтветОшибки(Ответ, "INTERNAL", "book: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции

// =========================================================
// 2. ОТМЕНА ЗАПИСИ (CancelPOST)
// =========================================================
Функция CancelPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        IDЗаписи = Данные.appointment_id;
        
        СсылкаНаЗаявку = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(IDЗаписи));

        Если СсылкаНаЗаявку.Пустая() Тогда
            Результат = Новый Структура("status, error", "error", "Документ не найден по ID");
        Иначе
            ОбъектЗаявки = СсылкаНаЗаявку.ПолучитьОбъект();
            
            СтатусОтменена = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена");
            Если НЕ СтатусОтменена.Пустая() Тогда ОбъектЗаявки.Состояние = СтатусОтменена; КонецЕсли;
            
            ОбъектЗаявки.ПометкаУдаления = Истина;
            ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
            Результат = Новый Структура("status", "success");
        КонецЕсли;
        
    Исключение
        Результат = Новый Структура("status, error", "error", ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции


// =========================================================
// 3. ПЕРЕНОС ЗАПИСИ (ReschedulePOST)
// Переносится та же заявка; пациент не меняется (R5).
// =========================================================
Функция ReschedulePOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        Если ПустаяСтрока(ЗначениеПоля(Данные, "old_appointment_id")) Тогда
            Возврат ОтветОшибки(Ответ, "BAD_REQUEST", "reschedule: нет old_appointment_id");
        КонецЕсли;
        
        Попытка
            СсылкаНаЗаявку = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.old_appointment_id));
            СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.doctor_id));
            Начало = ПарситьДату(Данные.date, Данные.time);
            СсылкаУслуга = СсылкаНаУслугу(Данные);
        Исключение
            Возврат ОтветОшибки(Ответ, "BAD_REQUEST", "reschedule: неверный идентификатор, date или time");
        КонецПопытки;
        Если СсылкаНаЗаявку.ПолучитьОбъект() = Неопределено Тогда
            Возврат ОтветОшибки(Ответ, "NOT_FOUND", "reschedule: заявка не найдена " + Данные.old_appointment_id);
        КонецЕсли;
        
        Телефон = "";
        Если Данные.Свойство("patient") Тогда
            Телефон = НормализоватьТелефон(ЗначениеПоля(Данные.patient, "phone"));
        КонецЕсли;
        
        // Длительность — как при записи, а не фиксированные 30 минут (FR-016).
        Окончание = Начало + ДлительностьЗаписи(СсылкаСотрудник, СсылкаУслуга);
        Филиал = Справочники.Филиалы.НайтиПоНаименованию(ЗначениеПоля(Данные, "branch"));
        
        Состояние = СостояниеЗаявкиБота(ЗначениеПоля(Данные, "service_name"));
        Если Не ЗначениеЗаполнено(Состояние) Тогда
            Возврат ОтветОшибки(Ответ, "STATE_NOT_CONFIGURED",
                "reschedule: нет состояния заявки " + ИмяСостоянияБота(ЗначениеПоля(Данные, "service_name")));
        КонецЕсли;

        НачатьТранзакцию();
        Попытка
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлок = Блокировка.Добавить("Справочник.Сотрудники");
            ЭлементБлок.УстановитьЗначение("Ссылка", СсылкаСотрудник);
            ЭлементБлок.Режим = РежимБлокировкиДанных.Исключительный;
            Блокировка.Заблокировать(); 
            
            Если ВремяЗанято(СсылкаСотрудник, Начало, Окончание, СсылкаНаЗаявку) Тогда
                ОтменитьТранзакцию(); 
                Возврат ОтветОшибки(Ответ, "SLOT_TAKEN", "");
            КонецЕсли;

            ОбъектЗаявки = СсылкаНаЗаявку.ПолучитьОбъект();
            ОбъектЗаявки.Сотрудник = СсылкаСотрудник;
            ОбъектЗаявки.ДатаНачала = Начало;
            ОбъектЗаявки.ВремяНачала = Начало;
            ОбъектЗаявки.ДатаОкончания = Окончание;
            ОбъектЗаявки.ВремяОкончания = Окончание;
            ОбъектЗаявки.Филиал = Филиал;
            ОбъектЗаявки.Примечание = ПримечаниеИсточника(Данные, Истина, Телефон);
            ОбъектЗаявки.Состояние = Состояние;
            
            ОбъектЗаявки.Работы.Очистить();
            ЗаполнитьРаботу(ОбъектЗаявки, СсылкаСотрудник, Начало, Окончание, СсылкаУслуга);

            ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
            ЗафиксироватьТранзакцию(); 
        Исключение
            ОтменитьТранзакцию(); 
            ВызватьИсключение; 
        КонецПопытки;
        
        СсылкаКлиент = ОбъектЗаявки.Клиент;
        Медкарта = ОбеспечитьМедкарту(СсылкаКлиент, Филиал, СсылкаНаЗаявку);
        Результат = Новый Структура("status, appointment_id, patient_id, patient, medical_card",
            "success", ИдентификаторСсылки(СсылкаНаЗаявку), ИдентификаторСсылки(СсылкаКлиент), "found", Медкарта);
        
    Исключение
        Возврат ОтветОшибки(Ответ, "INTERNAL", "reschedule: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции


// =========================================================
// 4. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// =========================================================

// --- Этап 1: общие функции записи и переноса (specs/002-patient-emk) ---

// Строковое значение поля структуры JSON или пустая строка.
Функция ЗначениеПоля(Структура, Имя)
    Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Имя) И Структура[Имя] <> Неопределено Тогда
        Возврат Строка(Структура[Имя]);
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ИдентификаторСсылки(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

// Журнал регистрации, событие «Бот.Запись». Без ФИО и телефона: только идентификаторы и причины.
Процедура ЗаписатьВЖурнал(Уровень, Текст)
    ЗаписьЖурналаРегистрации("Бот.Запись", Уровень, , , Текст);
КонецПроцедуры

// Ответ с машинным кодом (contracts/onec-book.md). Подробности — только в журнал регистрации.
Функция ОтветОшибки(Ответ, Код, ТекстДляЖурнала)
    Тексты = Новый Соответствие;
    Тексты.Вставить("SLOT_TAKEN", "Извините, это время уже занято.");
    Тексты.Вставить("BAD_PHONE", "Телефон не распознан.");
    Тексты.Вставить("BAD_BIRTH_DATE", "Дата рождения не распознана.");
    Тексты.Вставить("BAD_REQUEST", "Некорректный запрос.");
    Тексты.Вставить("STATE_NOT_CONFIGURED", "Запись не создана: в 1С не настроено состояние заявки бота.");
    Тексты.Вставить("NOT_FOUND", "Заявка не найдена.");
    Тексты.Вставить("INTERNAL", "Внутренняя ошибка 1С, подробности в журнале регистрации.");
    Текст = Тексты.Получить(Код);
    Если Текст = Неопределено Тогда Текст = Тексты.Получить("INTERNAL"); КонецЕсли;
    
    Если Не ПустаяСтрока(ТекстДляЖурнала) Тогда
        Уровень = ?(Код = "INTERNAL", УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Предупреждение);
        ЗаписатьВЖурнал(Уровень, Код + ": " + ТекстДляЖурнала);
    КонецЕсли;
    
    Ответ.КодСостояния = 200;
    Возврат СформироватьОтветJSON(Ответ, Новый Структура("status, code, error", "error", Код, Текст));
КонецФункции

// Последние 10 цифр номера (без кода страны) или пустая строка.
Функция ЦифрыТелефона(Знач Стр)
    Цифры = "";
    Для Поз = 1 По СтрДлина(Стр) Цикл
        Символ = Сред(Стр, Поз, 1);
        Если СтрНайти("0123456789", Символ) > 0 Тогда Цифры = Цифры + Символ; КонецЕсли;
    КонецЦикла;
    Если СтрДлина(Цифры) = 11 И (Лев(Цифры, 1) = "7" Или Лев(Цифры, 1) = "8") Тогда
        Цифры = Прав(Цифры, 10);
    КонецЕсли;
    Возврат ?(СтрДлина(Цифры) = 10, Цифры, "");
КонецФункции

// «+7 (999) 123-45-67», «8999…», «+7999…» → «+79991234567»; нераспознанный → пустая строка.
Функция НормализоватьТелефон(Знач Стр)
    Цифры = ЦифрыТелефона(Стр);
    Возврат ?(ПустаяСтрока(Цифры), "", "+7" + Цифры);
КонецФункции

// «YYYY-MM-DD» или «ДД.ММ.ГГГГ» → Дата; пустая, неверная, будущая или раньше 1900 года → Неопределено.
Функция ПарситьДатуРождения(Знач СтрДР)
    СтрДР = СокрЛП(СтрДР);
    Если СтрДлина(СтрДР) <> 10 Тогда Возврат Неопределено; КонецЕсли;
    Попытка
        Если Сред(СтрДР, 5, 1) = "-" И Сред(СтрДР, 8, 1) = "-" Тогда
            Результат = Дата(Число(Лев(СтрДР, 4)), Число(Сред(СтрДР, 6, 2)), Число(Прав(СтрДР, 2)));
        ИначеЕсли Сред(СтрДР, 3, 1) = "." И Сред(СтрДР, 6, 1) = "." Тогда
            Результат = Дата(Число(Прав(СтрДР, 4)), Число(Сред(СтрДР, 4, 2)), Число(Лев(СтрДР, 2)));
        Иначе
            Возврат Неопределено;
        КонецЕсли;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Если Результат < Дата(1900, 1, 1) Или Результат > ТекущаяДата() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СсылкаНаУслугу(Данные)
    ИдУслуги = ЗначениеПоля(Данные, "service_id");
    Если ПустаяСтрока(ИдУслуги) Тогда
        Возврат Справочники.Номенклатура.ПустаяСсылка();
    КонецЕсли;
    Возврат Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдУслуги));
КонецФункции

// Длительность в секундах: по услуге, затем по врачу, иначе 15 минут. Одинаково для записи и переноса.
Функция ДлительностьЗаписи(СсылкаСотрудник, СсылкаУслуга)
    ДлительностьВСекундах = 0;
    Если ЗначениеЗаполнено(СсылкаУслуга) Тогда
        Попытка
            Часы = ?(ЗначениеЗаполнено(СсылкаУслуга.ПродолжительностьЧас), СсылкаУслуга.ПродолжительностьЧас, 0);
            Минуты = ?(ЗначениеЗаполнено(СсылкаУслуга.ПродолжительностьМин), СсылкаУслуга.ПродолжительностьМин, 0);
            ОбщиеМинуты = (Часы * 60) + Минуты;
            Если ОбщиеМинуты > 0 Тогда ДлительностьВСекундах = ОбщиеМинуты * 60; КонецЕсли;
        Исключение КонецПопытки;
    КонецЕсли;
    Если ДлительностьВСекундах = 0 Тогда
        Попытка
            Если ТипЗнч(СсылкаСотрудник.ДлительностьПриема) = Тип("Число") И СсылкаСотрудник.ДлительностьПриема > 0 Тогда
                ДлительностьВСекундах = СсылкаСотрудник.ДлительностьПриема * 60;
            КонецЕсли;
        Исключение КонецПопытки;
    КонецЕсли;
    Если ДлительностьВСекундах = 0 Тогда ДлительностьВСекундах = 900; КонецЕсли;
    Возврат ДлительностьВСекундах;
КонецФункции

Функция ИмяСостоянияБота(ИмяУслуги)
    Если СтрНайти(НРег(ИмяУслуги), "повтор") > 0 И СтрНайти(НРег(ИмяУслуги), "первич") = 0 Тогда
        Возврат "BOT_Повторка";
    КонецЕсли;
    Возврат "BOT_Первичка";
КонецФункции

// Состояние заявки бота; пустая ссылка, если в 1С его нет (тогда запись не создаётся, R6).
Функция СостояниеЗаявкиБота(ИмяУслуги)
    Возврат Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию(ИмяСостоянияБота(ИмяУслуги), Истина);
КонецФункции

// «Запись из Telegram: +7…», «Перенос из MAX: +7…» — по полю platform (нет поля → Telegram).
Функция ПримечаниеИсточника(Данные, ЭтоПеренос, Телефон)
    Мессенджер = ?(НРег(ЗначениеПоля(Данные, "platform")) = "max", "MAX", "Telegram");
    Текст = ?(ЭтоПеренос, "Перенос из ", "Запись из ") + Мессенджер;
    Возврат Текст + ?(ПустаяСтрока(Телефон), "", ": " + Телефон);
КонецФункции

Функция ВремяЗанято(СсылкаСотрудник, Начало, Окончание, ИсключитьЗаявку = Неопределено)
    Попытка
        СостоянияОтмены = УправлениеЗаявками.СостоянияЗаявкиОтменена();
    Исключение
        СостоянияОтмены = Новый Массив;
        СостоянияОтмены.Добавить(Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена"));
    КонецПопытки;
    ЗапросПроверки = Новый Запрос;
    ЗапросПроверки.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1 Заявка.Ссылка ИЗ Документ.Заявка КАК Заявка
        |ГДЕ Заявка.Сотрудник = &Сотрудник И Заявка.ПометкаУдаления = ЛОЖЬ
        |И НЕ Заявка.Состояние В (&СостоянияОтмены)
        |И Заявка.Ссылка <> &ИсключитьЗаявку
        |И Заявка.ДатаНачала < &Окончание И Заявка.ДатаОкончания > &Начало";
    ЗапросПроверки.УстановитьПараметр("Сотрудник", СсылкаСотрудник);
    ЗапросПроверки.УстановитьПараметр("Начало", Начало);
    ЗапросПроверки.УстановитьПараметр("Окончание", Окончание);
    ЗапросПроверки.УстановитьПараметр("СостоянияОтмены", СостоянияОтмены);
    ЗапросПроверки.УстановитьПараметр("ИсключитьЗаявку",
        ?(ИсключитьЗаявку = Неопределено, Документы.Заявка.ПустаяСсылка(), ИсключитьЗаявку));
    Возврат Не ЗапросПроверки.Выполнить().Пустой();
КонецФункции

Процедура ЗаполнитьРаботу(ДокументЗаявка, СсылкаСотрудник, Начало, Окончание, СсылкаУслуга)
    НоваяСтрока = ДокументЗаявка.Работы.Добавить();
    НоваяСтрока.Сотрудник = СсылкаСотрудник;
    НоваяСтрока.Продолжительность = Дата("00010101") + (Окончание - Начало);
    НоваяСтрока.ДатаНачала = Начало;
    НоваяСтрока.ДатаОкончания = Окончание;
    Если ЗначениеЗаполнено(СсылкаУслуга) Тогда НоваяСтрока.Номенклатура = СсылкаУслуга; КонецЕсли;
КонецПроцедуры

// Ключ сравнения ФИО: штатная нормализация, нижний регистр, «ё»→«е», одиночные пробелы.
Функция КлючФИО(Знач Наименование)
    Попытка
        Наименование = ОтраслевыеДополнения.КонтрольКорректностиФИО(Наименование).Получить("Наименование");
    Исключение КонецПопытки;
    Текст = СтрЗаменить(НРег(Наименование), "ё", "е");
    Возврат СтрСоединить(СтрРазделить(Текст, " " + Символы.Таб + Символы.НПП, Ложь), " ");
КонецФункции

Функция ПолноеФИО(Фамилия, Имя, Отчество)
    Возврат СокрЛП(Фамилия + " " + Имя + ?(ПустаяСтрока(Отчество), "", " " + Отчество));
КонецФункции

// Поиск пациента (data-model.md › «Выбор среди совпавших»).
// Возврат: Структура(Клиент, Совпадений, ТелефонСовпал); Клиент пуст — не найден.
Функция НайтиПациента(Фамилия, Имя, Отчество, ДатаРождения, Телефон)
    Результат = Новый Структура("Клиент, Совпадений, ТелефонСовпал", Справочники.Клиенты.ПустаяСсылка(), 0, Ложь);
    Ключ = КлючФИО(ПолноеФИО(Фамилия, Имя, Отчество));
    ЦифрыИскомого = ЦифрыТелефона(Телефон);
    
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Клиенты.Ссылка КАК Ссылка,
        |    Клиенты.Наименование КАК Наименование,
        |    Клиенты.Комментарий КАК Комментарий,
        |    Клиенты.ОсновнаяМедицинскаяКарта <> ЗНАЧЕНИЕ(Справочник.МедицинскиеКарты.ПустаяСсылка) КАК ЕстьМедкарта,
        |    Клиенты.ДатаСоздания КАК ДатаСоздания
        |ИЗ
        |    Справочник.Клиенты КАК Клиенты
        |ГДЕ
        |    Клиенты.ДатаРождения = &ДатаРождения
        |    И НЕ Клиенты.ПометкаУдаления
        |    И НЕ Клиенты.ЭтоГруппа
        |УПОРЯДОЧИТЬ ПО
        |    ДатаСоздания";
    Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
    Кандидаты = Запрос.Выполнить().Выгрузить();
    
    Совпавшие = Новый Массив;
    Для Каждого Кандидат Из Кандидаты Цикл
        Если КлючФИО(Кандидат.Наименование) = Ключ Тогда Совпавшие.Добавить(Кандидат); КонецЕсли;
    КонецЦикла;
    Если Совпавшие.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
    
    // Телефоны кандидатов: регистр контактной информации (Поле1+Поле2+Поле3 и Представление)
    // и «Тел: …» из комментария клиентов, созданных ботом до этапа 1 (R3).
    Ссылки = Новый Массив;
    Для Каждого Кандидат Из Совпавшие Цикл Ссылки.Добавить(Кандидат.Ссылка); КонецЦикла;
    ЗапросТел = Новый Запрос;
    ЗапросТел.Текст =
        "ВЫБРАТЬ КИ.Объект КАК Объект, КИ.Поле1 КАК Поле1, КИ.Поле2 КАК Поле2, КИ.Поле3 КАК Поле3,
        |    КИ.Представление КАК Представление
        |ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
        |ГДЕ КИ.Объект В (&Ссылки) И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
    ЗапросТел.УстановитьПараметр("Ссылки", Ссылки);
    СовпалиПоТелефону = Новый Соответствие;
    Если Не ПустаяСтрока(ЦифрыИскомого) Тогда
        Выборка = ЗапросТел.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если ЦифрыТелефона(Строка(Выборка.Поле1) + Строка(Выборка.Поле2) + Строка(Выборка.Поле3)) = ЦифрыИскомого
                Или ЦифрыТелефона(Выборка.Представление) = ЦифрыИскомого Тогда
                СовпалиПоТелефону.Вставить(Выборка.Объект, Истина);
            КонецЕсли;
        КонецЦикла;
        Для Каждого Кандидат Из Совпавшие Цикл
            Поз = СтрНайти(Кандидат.Комментарий, "Тел:");
            Если Поз > 0 И ЦифрыТелефона(Лев(Сред(Кандидат.Комментарий, Поз + 4), 20)) = ЦифрыИскомого Тогда
                СовпалиПоТелефону.Вставить(Кандидат.Ссылка, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Претенденты = Новый Массив;
    Для Каждого Кандидат Из Совпавшие Цикл
        Если СовпалиПоТелефону.Получить(Кандидат.Ссылка) = Истина Тогда Претенденты.Добавить(Кандидат); КонецЕсли;
    КонецЦикла;
    Результат.ТелефонСовпал = Претенденты.Количество() > 0;
    Если Не Результат.ТелефонСовпал Тогда Претенденты = Совпавшие; КонецЕсли;
    
    // Из нескольких — с основной медкартой, затем самый ранний (уже упорядочены по дате создания).
    Выбранный = Претенденты[0];
    Для Каждого Кандидат Из Претенденты Цикл
        Если Кандидат.ЕстьМедкарта Тогда Выбранный = Кандидат; Прервать; КонецЕсли;
    КонецЦикла;
    Результат.Клиент = Выбранный.Ссылка;
    Результат.Совпадений = Претенденты.Количество();
    Возврат Результат;
КонецФункции

// Новый пациент — штатной записью (без режима Загрузка), чтобы сработали нормализация ФИО, автор
// и дата создания. Медкарта создаётся после фиксации транзакции (ОбеспечитьМедкарту).
Функция СоздатьПациента(Фамилия, Имя, Отчество, ДатаРождения)
    НовыйКлиент = Справочники.Клиенты.СоздатьЭлемент();
    НовыйКлиент.Фамилия      = Фамилия;
    НовыйКлиент.Имя          = Имя;
    НовыйКлиент.Отчество     = Отчество;
    НовыйКлиент.Наименование = ПолноеФИО(Фамилия, Имя, Отчество);
    НовыйКлиент.ДатаРождения = ДатаРождения;
    
    // Пол по отчеству (без пола ЭМК блокируется); иначе уточнит регистратура.
    ОкончаниеОтчества = НРег(Прав(Отчество, 2));
    Если ОкончаниеОтчества = "ич" Тогда
        НовыйКлиент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
    ИначеЕсли ОкончаниеОтчества = "на" Тогда
        НовыйКлиент.Пол = Перечисления.ПолФизическихЛиц.Женский;
    КонецЕсли;
    
    НовыйКлиент.ДополнительныеСвойства.Вставить("НеСоздаватьМедкарту", Истина);
    НовыйКлиент.Записать();
    Возврат НовыйКлиент.Ссылка;
КонецФункции

// Сотовый — так же, как его пишет форма карточки: 7 / код / номер, представление +7XXXXXXXXXX (R3).
Процедура ЗаписатьТелефонПациента(Клиент, Телефон, Заявка)
    Цифры = ЦифрыТелефона(Телефон);
    Если ПустаяСтрока(Цифры) Тогда Возврат; КонецЕсли;
    Попытка
        Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
        Запись.Объект = Клиент;
        Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
        Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
        Запись.Поле1 = "7";
        Запись.Поле2 = Лев(Цифры, 3);
        Запись.Поле3 = Сред(Цифры, 4);
        Запись.Представление = "+7" + Цифры;
        Запись.Записать();
    Исключение
        ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
            "Телефон не записан в карточку клиента " + ИдентификаторСсылки(Клиент) + ": "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        ДобавитьПримечаниеЗаявки(Заявка, "Телефон не записан в карточку пациента — внести вручную");
    КонецПопытки;
КонецПроцедуры

// Основная медкарта пациента: "existing" | "created" | "missing" (FR-003, FR-006).
Функция ОбеспечитьМедкарту(Клиент, Филиал, Заявка)
    Если Не ЗначениеЗаполнено(Клиент) Тогда
        ДобавитьПримечаниеЗаявки(Заявка, "Медкарту завести вручную: в заявке нет пациента");
        Возврат "missing";
    КонецЕсли;
    Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ОсновнаяМедицинскаяКарта")) Тогда
        Возврат "existing";
    КонецЕсли;
    
    Причина = "";
    Попытка
        Параметры = Новый Структура;
        Если ЗначениеЗаполнено(Филиал) Тогда Параметры.Вставить("Филиал", Филиал); КонецЕсли;
        // Ложь — создать, даже если автосоздание медкарт в учётной политике выключено.
        Справочники.Клиенты.СоздатьМедкартуКлиента(Клиент, Параметры, Ложь);
    Исключение
        Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    
    Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ОсновнаяМедицинскаяКарта")) Тогда
        Возврат "created";
    КонецЕсли;
    Если ПустаяСтрока(Причина) Тогда
        Причина = "не задан основной вид медкарт в учётной политике";
    КонецЕсли;
    ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
        "Медкарта не создана для клиента " + ИдентификаторСсылки(Клиент) + ": " + Причина);
    ДобавитьПримечаниеЗаявки(Заявка, "Медкарту завести вручную: " + Причина);
    Возврат "missing";
КонецФункции

Процедура ДобавитьПримечаниеЗаявки(Заявка, Текст)
    Если Не ЗначениеЗаполнено(Заявка) Тогда Возврат; КонецЕсли;
    Попытка
        ОбъектЗаявки = Заявка.ПолучитьОбъект();
        ОбъектЗаявки.Примечание = СокрП(ОбъектЗаявки.Примечание) + Символы.ПС + Текст;
        ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
    Исключение
        ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
            "Не удалось дополнить примечание заявки " + ИдентификаторСсылки(Заявка) + ": "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

// --- Прежние вспомогательные функции ---

Функция ПарситьДату(СтрДата, СтрВремя)
    Возврат Дата(Число(Лев(СтрДата, 4)), Число(Сред(СтрДата, 6, 2)), Число(Прав(СтрДата, 2)), 
                Число(Лев(СтрВремя, 2)), Число(Прав(СтрВремя, 2)), 0);
КонецФункции

Функция ПрочитатьДанныеИзЗапроса(Запрос)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    ДанныеJSON = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат ДанныеJSON;
КонецФункции

Функция СформироватьОтветJSON(Ответ, СтруктураДанных)
    ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ScheduleGET(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ИДВрачаСтрока  = Запрос.ПараметрыЗапроса.Получить("doctor_id");
	ИмяФилиала     = Запрос.ПараметрыЗапроса.Получить("branch");
	ДатаСтрока     = Запрос.ПараметрыЗапроса.Получить("date");
	ДатаНачалаСтр  = Запрос.ПараметрыЗапроса.Получить("start_date");
	ДатаОкончСтр   = Запрос.ПараметрыЗапроса.Получить("end_date");
	
	Попытка
		ДатаНач = ТекущаяДата();
		ДатаКон = ТекущаяДата();
		
		// Надежная проверка на Неопределено
		Если ДатаНачалаСтр <> Неопределено И ДатаОкончСтр <> Неопределено Тогда
			ДатаНач = Дата(Число(Лев(ДатаНачалаСтр, 4)), Число(Сред(ДатаНачалаСтр, 6, 2)), Число(Прав(ДатаНачалаСтр, 2)));
			ДатаКон = Дата(Число(Лев(ДатаОкончСтр, 4)), Число(Сред(ДатаОкончСтр, 6, 2)), Число(Прав(ДатаОкончСтр, 2)));
		ИначеЕсли ДатаСтрока <> Неопределено Тогда
			ДатаНач = Дата(Число(Лев(ДатаСтрока, 4)), Число(Сред(ДатаСтрока, 6, 2)), Число(Прав(ДатаСтрока, 2)));
			ДатаКон = ДатаНач;
		КонецЕсли;

		СсылкаВрач = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДВрачаСтрока));
		СсылкаФилиал = Справочники.Филиалы.НайтиПоНаименованию(?(ИмяФилиала = Неопределено, "", ИмяФилиала));
		ИмяФилиалаНРег = НРег(?(ИмяФилиала = Неопределено, "", ИмяФилиала));
		ТекДатаСервер = ТекущаяДата(); 

		// Запрашиваем данные СРАЗУ ЗА ВЕСЬ ПЕРИОД
		ЗапросБД = Новый Запрос;
		ЗапросБД.УстановитьПараметр("Врач", СсылкаВрач);
		ЗапросБД.УстановитьПараметр("Нач", НачалоДня(ДатаНач));
		ЗапросБД.УстановитьПараметр("Кон", КонецДня(ДатаКон));
		ЗапросБД.УстановитьПараметр("Филиал", СсылкаФилиал);
		ЗапросБД.УстановитьПараметр("СтатусОтмены", Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена"));
		
		ЗапросБД.Текст = 
			"ВЫБРАТЬ График.Дата КАК Дата, График.ВремяНачала КАК Нач, График.ВремяОкончания КАК Кон, ПРЕДСТАВЛЕНИЕ(График.ВидВремени) КАК Вид ИЗ РегистрСведений.ГрафикиРаботы КАК График 
			|ГДЕ График.Сотрудник = &Врач И График.Дата МЕЖДУ &Нач И &Кон И График.Филиал = &Филиал;
			|ВЫБРАТЬ Заявка.ДатаНачала КАК Нач, Заявка.ВремяОкончания КАК Кон ИЗ Документ.Заявка КАК Заявка 
			|ГДЕ Заявка.Сотрудник = &Врач И Заявка.ДатаНачала МЕЖДУ &Нач И &Кон И Заявка.ПометкаУдаления = ЛОЖЬ И Заявка.Состояние <> &СтатусОтмены;
			|ВЫБРАТЬ Событие.ДатаПлан КАК Нач, ДОБАВИТЬКДАТЕ(Событие.ДатаПлан, МИНУТА, 60) КАК Кон ИЗ Документ.Событие КАК Событие 
			|ГДЕ Событие.Филиал = &Филиал И Событие.ДатаПлан МЕЖДУ &Нач И &Кон И Событие.ПометкаУдаления = ЛОЖЬ"; 
			
		Пакет = ЗапросБД.ВыполнитьПакет();
		Шаг = 1800; // ЖЕСТКИЙ ШАГ 30 МИНУТ
		
		ТаблЗанятоПоДатам = Новый Соответствие;
		
		ВыбЗ = Пакет[1].Выбрать();
		Пока ВыбЗ.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыбЗ.Нач) И ЗначениеЗаполнено(ВыбЗ.Кон) Тогда
				КлючДаты = Формат(НачалоДня(ВыбЗ.Нач), "ДФ=yyyy-MM-dd");
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", Число(ВыбЗ.Нач - НачалоДня(ВыбЗ.Нач)), Число(ВыбЗ.Кон - НачалоДня(ВыбЗ.Кон))));
			КонецЕсли;
		КонецЦикла;
		
		ВыбС = Пакет[2].Выбрать();
		Пока ВыбС.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыбС.Нач) И ЗначениеЗаполнено(ВыбС.Кон) Тогда
				КлючДаты = Формат(НачалоДня(ВыбС.Нач), "ДФ=yyyy-MM-dd");
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", Число(ВыбС.Нач - НачалоДня(ВыбС.Нач)), Число(ВыбС.Кон - НачалоДня(ВыбС.Кон))));
			КонецЕсли;
		КонецЦикла;
		
		РабочиеИнтервалыПоДатам = Новый Соответствие;
		ВыбГрафик = Пакет[0].Выбрать();
		
		Пока ВыбГрафик.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыбГрафик.Нач) ИЛИ НЕ ЗначениеЗаполнено(ВыбГрафик.Кон) Тогда Продолжить; КонецЕсли;
			
			КлючДаты = Формат(НачалоДня(ВыбГрафик.Дата), "ДФ=yyyy-MM-dd");
			
			НачСек = Число(ВыбГрафик.Нач - НачалоДня(ВыбГрафик.Нач));
			КонСек = Число(ВыбГрафик.Кон - НачалоДня(ВыбГрафик.Кон));
			ВидНРег = НРег(ВыбГрафик.Вид);
			
			Если Найти(ВидНРег, "рабочее время") > 0 Тогда
				МассивРаб = РабочиеИнтервалыПоДатам.Получить(КлючДаты);
				Если МассивРаб = Неопределено Тогда МассивРаб = Новый Массив; РабочиеИнтервалыПоДатам.Вставить(КлючДаты, МассивРаб); КонецЕсли;
				МассивРаб.Добавить(Новый Структура("НачСек, КонСек", НачСек, КонСек));
			Иначе
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", НачСек, КонСек));
			КонецЕсли;
		КонецЦикла;
		
		// --- ИСПРАВЛЕНИЕ ТУТ: Используем Соответствие, так как ключи - даты (строки с цифрами) ---
		РезультатПоДатам = Новый Соответствие; 
		
		ТекДень = НачалоДня(ДатаНач);
		Пока ТекДень <= НачалоДня(ДатаКон) Цикл
			КлючДатыТек = Формат(ТекДень, "ДФ=yyyy-MM-dd");
			
			ДеньНеделиЗапроса = ДеньНедели(ТекДень);
			КрайнееВремяВСекундах = 86400; 
			
			Если Найти(ИмяФилиалаНРег, "профсоюзная") > 0 ИЛИ Найти(ИмяФилиалаНРег, "ватутинки") > 0 Тогда
				Если ДеньНеделиЗапроса <= 5 Тогда КрайнееВремяВСекундах = 63000;
				ИначеЕсли ДеньНеделиЗапроса = 6 Тогда КрайнееВремяВСекундах = 59400;
				ИначеЕсли ДеньНеделиЗапроса = 7 Тогда КрайнееВремяВСекундах = 52200;
				КонецЕсли;
			КонецЕсли;
			
			МассивСлотовДня = Новый Массив;
			РабИнтервалыДня = РабочиеИнтервалыПоДатам.Получить(КлючДатыТек);
			ЗанИнтервалыДня = ТаблЗанятоПоДатам.Получить(КлючДатыТек);
			Если ЗанИнтервалыДня = Неопределено Тогда ЗанИнтервалыДня = Новый Массив; КонецЕсли;
			
			Если РабИнтервалыДня <> Неопределено Тогда
				Для Каждого Раб Из РабИнтервалыДня Цикл
					Тек = Раб.НачСек;
					КонецГрафика = Раб.КонСек;
					
					Пока Тек + Шаг <= КонецГрафика Цикл
						Своб = Истина; К = Тек + Шаг;
						ВремяНачала = ТекДень + Тек;
						
						Если ВремяНачала <= ТекДатаСервер ИЛИ Тек > КрайнееВремяВСекундах Тогда Своб = Ложь; КонецЕсли;
						
						Если Своб Тогда
							Для Каждого Занято Из ЗанИнтервалыДня Цикл
								Если (Тек < Занято.КонСек) И (К > Занято.НачСек) Тогда 
									Своб = Ложь; Прервать; 
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						
						Если Своб Тогда МассивСлотовДня.Добавить(Формат(ВремяНачала, "ДФ=HH:mm")); КонецЕсли;
						Тек = Тек + Шаг;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			РезультатПоДатам.Вставить(КлючДатыТек, МассивСлотовДня);
			ТекДень = ТекДень + 86400; // Следующий день
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
		ДанныеОтвета = Новый Структура("status, schedule", "success", РезультатПоДатам);
		ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"": """ + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}", КодировкаТекста.UTF8);
	КонецПопытки;
	
	Возврат Ответ;
КонецФункции


Функция PingGET(Запрос)
    
    // Создаем ответ со статусом 200 OK
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // Формируем структуру, которая превратится в JSON
    СтруктураОтвета = Новый Структура;
    СтруктураОтвета.Вставить("status", "success");
    СтруктураОтвета.Вставить("message", "1C API is running!");
    
    // Превращаем структуру в строку JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // Кладем JSON в тело ответа
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    
    Возврат Ответ;

КонецФункции

Функция SpecialtiesGET(Запрос)
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // ВАЖНО: "Справочник.Специальности" - нужно проверить, 
    // как точно называется этот справочник в вашей УМЦ (может быть "Специализации" или "Должности")
    ТекстЗапроса = 
        "ВЫБРАТЬ
        |   Специальности.Ссылка КАК Ссылка,
        |   Специальности.Наименование КАК Наименование
        |ИЗ
        |   Справочник.Специальности КАК Специальности
        |ГДЕ
        |   Специальности.ПометкаУдаления = ЛОЖЬ";
        
    ЗапросБД = Новый Запрос;
    ЗапросБД.Текст = ТекстЗапроса;
    Результат = ЗапросБД.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Собираем массив данных
    МассивДанных = Новый Массив;
    Пока Выборка.Следующий() Цикл
        ЭлементДанных = Новый Структура;
        // Превращаем GUID 1C в обычную строку
        ЭлементДанных.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
        ЭлементДанных.Вставить("name", Выборка.Наименование);
        МассивДанных.Добавить(ЭлементДанных);
    КонецЦикла;
    
    // Собираем финальный ответ
    СтруктураОтвета = Новый Структура;
    СтруктураОтвета.Вставить("status", "success");
    СтруктураОтвета.Вставить("data", МассивДанных);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
    
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    
    Возврат Ответ;

КонецФункции

Функция DoctorsGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    ИмяФилиала = СокрЛП(Запрос.ПараметрыЗапроса.Получить("branch"));
    ДатаСтрока = Запрос.ПараметрыЗапроса.Получить("date"); // Получаем дату из бота
    
    // Превращаем строку YYYY-MM-DD в дату 1С
    ДатаЗапроса = Дата(1,1,1);
    Если ЗначениеЗаполнено(ДатаСтрока) И СтрДлина(ДатаСтрока) >= 10 Тогда
        Попытка
            Год = Число(Лев(ДатаСтрока, 4));
            Месяц = Число(Сред(ДатаСтрока, 6, 2));
            День = Число(Сред(ДатаСтрока, 9, 2));
            ДатаЗапроса = Дата(Год, Месяц, День);
        Исключение
        КонецПопытки;
    КонецЕсли;

    ЗапросБД = Новый Запрос;
    
    // 1. Базовый запрос к Справочнику Сотрудников (ищем тех, у кого стоит галочка)
    ТекстЗапроса = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   Сотрудники.Ссылка КАК Ссылка,
        |   Сотрудники.Наименование КАК full_name,
        |   ПРЕДСТАВЛЕНИЕ(Сотрудники.Должность) КАК specialty_name
        |ИЗ
        |   Справочник.Сотрудники КАК Сотрудники
        |ГДЕ
        |   Сотрудники.ПометкаУдаления = ЛОЖЬ
        |   И Сотрудники.УчаствуетВОнлайнЗаписи = ИСТИНА";

    УсловиеГрафика = "";

    // 2. Если пришла дата или филиал, добавляем строгие фильтры по графику
    Если ДатаЗапроса <> Дата(1,1,1) Тогда
        УсловиеГрафика = УсловиеГрафика + " И ГрафикиРаботы.Дата = &Дата";
        ЗапросБД.УстановитьПараметр("Дата", ДатаЗапроса);
    КонецЕсли;

    Если ЗначениеЗаполнено(ИмяФилиала) Тогда
        УсловиеГрафика = УсловиеГрафика + " И ГрафикиРаботы.Филиал.Наименование ПОДОБНО &Филиал";
        ЗапросБД.УстановитьПараметр("Филиал", "%" + ИмяФилиала + "%");
    КонецЕсли;

    // Подключаем фильтр по регистру графиков, если переданы параметры
    Если СтрДлина(УсловиеГрафика) > 0 Тогда
        ТекстЗапроса = ТекстЗапроса + "
        |   И Сотрудники.Ссылка В (
        |       ВЫБРАТЬ РАЗЛИЧНЫЕ
        |           ГрафикиРаботы.Сотрудник
        |       ИЗ
        |           РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
        |       ГДЕ
        |           ИСТИНА " + УсловиеГрафика + "
        |   )";
    КонецЕсли;

    ЗапросБД.Текст = ТекстЗапроса;

    Попытка
        Выборка = ЗапросБД.Выполнить().Выбрать();
        Массив = Новый Массив;
        
        Пока Выборка.Следующий() Цикл
            // Жесткая проверка на слово "офтальмолог" удалена. 
            // Теперь бот верит твоей галочке "УчаствуетВОнлайнЗаписи".
            Сотрудник = Новый Структура("id, full_name, specialty_name");
            Сотрудник.id = Строка(Выборка.Ссылка.УникальныйИдентификатор());
            Сотрудник.full_name = Выборка.full_name;
            Сотрудник.specialty_name = Выборка.specialty_name;
            Массив.Добавить(Сотрудник);
        КонецЦикла;
        
        ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Массив);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Исключение
        Ответ.КодСостояния = 500;
        Ответ.УстановитьТелоИзСтроки("{""detail"": """ + ОписаниеОшибки() + """}", КодировкаТекста.UTF8);
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции

Функция ServicesGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Массив = Новый Массив;
    
    Попытка
        IDВрача = Запрос.ПараметрыЗапроса.Получить("doctor_id");
        ЗапросБД = Новый Запрос;
        
        // Добавляем параметр для получения актуальных цен на сегодня
        ЗапросБД.УстановитьПараметр("ТекДата", ТекущаяДата());
        
        Если ЗначениеЗаполнено(IDВрача) И IDВрача <> "undefined" И IDВрача <> "null" Тогда
            
            СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(IDВрача));
            ЗапросБД.УстановитьПараметр("Сотрудник", СсылкаСотрудник);
            
            ЗапросБД.Текст = 
                "ВЫБРАТЬ
                |   Регистр.Номенклатура.Ссылка КАК id,
                |   Регистр.Номенклатура.Наименование КАК name,
                |   ЕСТЬNULL(Цены.Цена, 0) КАК price
                |ИЗ
                |   РегистрСведений.ОсновныеУслугиСотрудников КАК Регистр
                |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекДата, ) КАК Цены
                |       ПО Регистр.Номенклатура = Цены.Номенклатура
                |ГДЕ
                |   Регистр.Сотрудник = &Сотрудник
                |   И Регистр.Номенклатура.ПометкаУдаления = ЛОЖЬ
                |   И Регистр.Номенклатура.ЭтоГруппа = ЛОЖЬ
                |   И Регистр.Номенклатура.УчаствуетВОнлайнЗаписи = ИСТИНА";
        Иначе
            ЗапросБД.Текст = 
                "ВЫБРАТЬ
                |   Номенклатура.Ссылка КАК id,
                |   Номенклатура.Наименование КАК name,
                |   ЕСТЬNULL(Цены.Цена, 0) КАК price
                |ИЗ
                |   Справочник.Номенклатура КАК Номенклатура
                |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекДата, ) КАК Цены
                |       ПО Номенклатура.Ссылка = Цены.Номенклатура
                |ГДЕ
                |   Номенклатура.ПометкаУдаления = ЛОЖЬ
                |   И Номенклатура.ЭтоГруппа = ЛОЖЬ
                |   И Номенклатура.УчаствуетВОнлайнЗаписи = ИСТИНА";
        КонецЕсли;
            
        Выборка = ЗапросБД.Выполнить().Выбрать();
        
        // Добавили price в формируемую структуру
        Пока Выборка.Следующий() Цикл
            Массив.Добавить(Новый Структура("id, name, price", Строка(Выборка.id.УникальныйИдентификатор()), Выборка.name, Выборка.price));
        КонецЦикла;
        
        Если Массив.Количество() = 0 Тогда
            Массив.Добавить(Новый Структура("id, name", "empty", "Нет доступных услуг для данного врача"));
        КонецЕсли;

    Исключение
        Массив.Очистить();
        Массив.Добавить(Новый Структура("id, name", "error", "ОШИБКА 1С: " + ОписаниеОшибки()));
    КонецПопытки;
    
    ЗаписьJSON = Новый ЗаписьJSON; 
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Массив);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    
    Возврат Ответ;
КонецФункции


Функция UpdateNotePOST(Запрос)
    
    // Подготовим стандартный ответ
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // 1. Читаем входящий JSON от нашего Python-бота
        // (предполагается, что ПрочитатьДанныеИзЗапроса уже есть в вашем модуле, 
        //  так как она используется в BookPOST)
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        ИДЗаписи = Данные.appointment_id;
        НовыйКомментарий = Данные.note; // Сюда придет: "✅ Визит подтвержден пациентом (MAX)"
        
        // 2. Ищем документ по его УИД (уникальному идентификатору)
        УИД = Новый УникальныйИдентификатор(ИДЗаписи);
        
        // В BookPOST мы видим, что используется Документ.Заявка
        СсылкаНаДокумент = Документы.Заявка.ПолучитьСсылку(УИД); 
        
        // Проверяем, существует ли реально такой документ
        Если СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
            Результат = Новый Структура("status, error", "error", "Документ не найден в 1С");
            Ответ.КодСостояния = 404;
            Возврат СформироватьОтветJSON(Ответ, Результат);
        КонецЕсли;
        
        // 3. Блокируем объект для изменения и пишем комментарий
        ОбъектДок = СсылкаНаДокумент.ПолучитьОбъект();
        
        // Дописываем наш текст с новой строки в ПРИМЕЧАНИЕ
        // (чтобы не затереть то, что уже было, например "Запись из MAX: +7 999...")
        Если ПустаяСтрока(ОбъектДок.Примечание) Тогда
            ОбъектДок.Примечание = НовыйКомментарий;
        Иначе
            // Получится: 
            // ✅ Визит подтвержден пациентом (MAX)
            // Запись из MAX: +7 999 123-45-67
            ОбъектДок.Примечание = НовыйКомментарий + Символы.ПС + ОбъектДок.Примечание;
        КонецЕсли;
        
        // Записываем документ в базу
        ОбъектДок.Записать(РежимЗаписиДокумента.Запись);
        
        // 4. Отвечаем боту, что всё супер
        Результат = Новый Структура("status", "success");
        
    Исключение
        Ответ.КодСостояния = 500;
        Результат = Новый Структура("status, error", "error", "ОШИБКА 1С: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
    
КонецФункции

