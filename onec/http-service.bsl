// =========================================================
// 1. СОЗДАНИЕ НОВОЙ ЗАПИСИ (BookPOST)
// =========================================================
// =========================================================
// 1. СОЗДАНИЕ НОВОЙ ЗАПИСИ (BookPOST)
// =========================================================
// =========================================================
// 1. СОЗДАНИЕ НОВОЙ ЗАПИСИ (BookPOST)
// =========================================================
Функция BookPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        // ПОДГОТОВКА ДАННЫХ
        СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.doctor_id));
        Начало = ПарситьДату(Данные.date, Данные.time);
        Телефон = ОчиститьТелефон(Данные.patient.phone);
        
        Фамилия  = СокрЛП(Данные.patient.last_name);
        Имя      = СокрЛП(Данные.patient.first_name);
        Отчество = СокрЛП(Данные.patient.middle_name);
        ФИО_Полное = СокрЛП(Фамилия + " " + Имя + ?(ПустаяСтрока(Отчество), "", " " + Отчество));
        ДатаРожд = ПарситьДатуРождения(Данные.patient.birth_date);

        // УМНЫЙ РАСЧЕТ ДЛИТЕЛЬНОСТИ
        СсылкаУслуга = Справочники.Номенклатура.ПустаяСсылка();
        Если Данные.Свойство("service_id") И ЗначениеЗаполнено(Данные.service_id) Тогда
            СсылкаУслуга = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.service_id));
        КонецЕсли;

        ДлительностьВСекундах = 0;
        Если НЕ СсылкаУслуга.Пустая() Тогда
            Попытка
                Часы = ?(ЗначениеЗаполнено(СсылкаУслуга.ПродолжительностьЧас), СсылкаУслуга.ПродолжительностьЧас, 0);
                Минуты = ?(ЗначениеЗаполнено(СсылкаУслуга.ПродолжительностьМин), СсылкаУслуга.ПродолжительностьМин, 0);
                ОбщиеМинуты = (Часы * 60) + Минуты;
                Если ОбщиеМинуты > 0 Тогда ДлительностьВСекундах = ОбщиеМинуты * 60; КонецЕсли;
            Исключение КонецПопытки;
        КонецЕсли;

        Если ДлительностьВСекундах = 0 Тогда
            Попытка
                Если ТипЗнч(СсылкаСотрудник.ДлительностьПриема) = Тип("Число") И СсылкаСотрудник.ДлительностьПриема > 0 Тогда
                    ДлительностьВСекундах = СсылкаСотрудник.ДлительностьПриема * 60;
                КонецЕсли;
            Исключение КонецПопытки;
        КонецЕсли;

        Если ДлительностьВСекундах = 0 Тогда ДлительностьВСекундах = 900; КонецЕсли; // 15 мин по умолчанию
        Окончание = Начало + ДлительностьВСекундах;

        НачатьТранзакцию();
        Попытка
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлок = Блокировка.Добавить("Справочник.Сотрудники");
            ЭлементБлок.УстановитьЗначение("Ссылка", СсылкаСотрудник);
            ЭлементБлок.Режим = РежимБлокировкиДанных.Исключительный;
            Блокировка.Заблокировать(); 
            
            // ПРОВЕРКА ЗАНЯТОСТИ ВРЕМЕНИ
            ЗапросПроверки = Новый Запрос;
            ЗапросПроверки.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Заявка КАК Заявка
                |ГДЕ Заявка.Сотрудник = &Сотрудник И Заявка.ПометкаУдаления = ЛОЖЬ
                |И Заявка.Состояние <> &СтатусОтмены
                |И Заявка.ДатаНачала < &Окончание И Заявка.ДатаОкончания > &Начало";
                
            ЗапросПроверки.УстановитьПараметр("Сотрудник", СсылкаСотрудник);
            ЗапросПроверки.УстановитьПараметр("Начало", Начало);
            ЗапросПроверки.УстановитьПараметр("Окончание", Окончание);
            ЗапросПроверки.УстановитьПараметр("СтатусОтмены", Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена"));
            
            Если НЕ ЗапросПроверки.Выполнить().Пустой() Тогда
                ОтменитьТранзакцию(); 
                Возврат СформироватьОтветJSON(Ответ, Новый Структура("status, error", "error", "Извините, это время уже занято."));
            КонецЕсли;

            // ПОИСК ИЛИ СОЗДАНИЕ КЛИЕНТА
            ЗапросПоиска = Новый Запрос;
            ЗапросПоиска.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Клиенты 
                |ГДЕ Наименование = &ФИО И ДатаРождения = &ДатаРождения И ПометкаУдаления = ЛОЖЬ";
            ЗапросПоиска.УстановитьПараметр("ФИО", ФИО_Полное);
            ЗапросПоиска.УстановитьПараметр("ДатаРождения", ДатаРожд);
            
            РезультатПоиска = ЗапросПоиска.Выполнить();
            Если НЕ РезультатПоиска.Пустой() Тогда
                СсылкаКлиент = РезультатПоиска.Выгрузить()[0].Ссылка; 
            Иначе
                НовыйКлиент = Справочники.Клиенты.СоздатьЭлемент();
                НовыйКлиент.ОбменДанными.Загрузка = Истина; 
                НовыйКлиент.Фамилия       = Фамилия;
                НовыйКлиент.Имя           = Имя;
                НовыйКлиент.Отчество      = Отчество;
                НовыйКлиент.Наименование  = ФИО_Полное;
                НовыйКлиент.ДатаРождения  = ДатаРожд;
                
                // Автоопределение пола (без этого ЭМК блокируется)
                Если ЗначениеЗаполнено(Отчество) Тогда
                    ОкончаниеОтчества = НРег(Прав(Отчество, 2));
                    Если ОкончаниеОтчества = "ич" Тогда
                        Попытка НовыйКлиент.Пол = Перечисления.ПолФизическихЛиц.Мужской; Исключение КонецПопытки;
                    ИначеЕсли ОкончаниеОтчества = "на" Тогда
                        Попытка НовыйКлиент.Пол = Перечисления.ПолФизическихЛиц.Женский; Исключение КонецПопытки;
                    КонецЕсли;
                КонецЕсли;

                Попытка
                    НоваяСтрокаКИ = НовыйКлиент.КонтактнаяИнформация.Добавить();
                    НоваяСтрокаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
                    НоваяСтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Сотовый телефон");
                    НоваяСтрокаКИ.Представление = Телефон; 
                    Попытка НоваяСтрокаКИ.НомерТелефона = Телефон; Исключение КонецПопытки;
                Исключение
                    НовыйКлиент.Комментарий = "Тел: " + Телефон;
                КонецПопытки;
                
                НовыйКлиент.Записать();
                СсылкаКлиент = НовыйКлиент.Ссылка;
            КонецЕсли;

            // === ИЗМЕНЕНИЕ 2: ИДЕАЛЬНОЕ СОЗДАНИЕ МЕДИЦИНСКОЙ КАРТЫ С РОДНОЙ ЛОГИКОЙ ===
            Попытка
                ЗапросКарты = Новый Запрос;
                ЗапросКарты.Текст = 
                    "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.МедицинскиеКарты 
                    |ГДЕ Пациент = &Клиент И ПометкаУдаления = ЛОЖЬ";
                ЗапросКарты.УстановитьПараметр("Клиент", СсылкаКлиент);
                
                Если ЗапросКарты.Выполнить().Пустой() Тогда
                    НоваяКарта = Справочники.МедицинскиеКарты.СоздатьЭлемент();
                    
                    // Основные поля
                    Попытка НоваяКарта.Пациент = СсылкаКлиент; Исключение КонецПопытки;
                    Попытка НоваяКарта.ДатаРегистрации = НачалоДня(ТекущаяДата()); Исключение КонецПопытки;
                    
                    СсылкаФилиал = Справочники.Филиалы.НайтиПоНаименованию(Данные.branch);
                    Если НЕ СсылкаФилиал.Пустая() Тогда
                        Попытка НоваяКарта.Филиал = СсылкаФилиал; Исключение КонецПопытки; 
                        Попытка НоваяКарта.ФилиалДляПечати = СсылкаФилиал; Исключение КонецПопытки;
                    КонецЕсли;
                    
                    // Умный поиск вида карты (ищем форму 025/у)
                    ЗапросВида = Новый Запрос;
                    ЗапросВида.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыМедицинскихКарт ГДЕ Наименование ПОДОБНО &Вид И ПометкаУдаления = ЛОЖЬ";
                    ЗапросВида.УстановитьПараметр("Вид", "%025/у%");
                    ВыбВид = ЗапросВида.Выполнить().Выбрать();
                    Если ВыбВид.Следующий() Тогда
                        НоваяКарта.ВидКарты = ВыбВид.Ссылка;
                    Иначе
                        ЗапросВида.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыМедицинскихКарт ГДЕ ПометкаУдаления = ЛОЖЬ";
                        ВыбВид = ЗапросВида.Выполнить().Выбрать();
                        Если ВыбВид.Следующий() Тогда НоваяКарта.ВидКарты = ВыбВид.Ссылка; КонецЕсли;
                    КонецЕсли;

                    // --- БЕЗОПАСНАЯ ИМИТАЦИЯ РОДНОГО МЕХАНИЗМА 1С ---
                    НовыйНомер = 0;
                    Если ЗначениеЗаполнено(НоваяКарта.ВидКарты) Тогда
                        Попытка НовыйНомер = НоваяКарта.ВидКарты.НачальныйНомер; Исключение КонецПопытки;
                        
                        ЗапросНомер = Новый Запрос;
                        // Ищем свободный номер строго в рамках выбранного Вида Карты, как в оригинале
                        ЗапросНомер.Текст = 
                            "ВЫБРАТЬ ПЕРВЫЕ 1 НомерКарты ИЗ Справочник.МедицинскиеКарты 
                            |ГДЕ ВидКарты = &Вид УПОРЯДОЧИТЬ ПО НомерКарты УБЫВ";
                        ЗапросНомер.УстановитьПараметр("Вид", НоваяКарта.ВидКарты);
                        ВыбНомер = ЗапросНомер.Выполнить().Выбрать();
                        
                        Если ВыбНомер.Следующий() И ЗначениеЗаполнено(ВыбНомер.НомерКарты) Тогда
                            НовыйНомер = ВыбНомер.НомерКарты + 1;
                        КонецЕсли;
                    КонецЕсли;
                    
                    Если НовыйНомер = 0 Тогда НовыйНомер = 1; КонецЕсли;
                    
                    Попытка НоваяКарта.НомерКарты = НовыйНомер; Исключение КонецПопытки;
                    
                    // Формируем Наименование с учетом настроек Вида Карты
                    ДлинаНомера = 5; 
                    Попытка ДлинаНомера = НоваяКарта.ВидКарты.ДлинаНомера; Исключение КонецПопытки;
                    Если ДлинаНомера = 0 Или НЕ ЗначениеЗаполнено(ДлинаНомера) Тогда ДлинаНомера = 5; КонецЕсли;
                    
                    // Форматируем число (например, добавляем лидирующие нули, если они нужны настройками)
                    СтрокаНомера = Формат(НовыйНомер, "ЧЦ=" + Строка(ДлинаНомера) + "; ЧВН=; ЧГ=0");
                    
                    ИмяКарты = "";
                    Попытка 
                        Если ЗначениеЗаполнено(НоваяКарта.ВидКарты.Префикс) Тогда ИмяКарты = ИмяКарты + СокрЛ(НоваяКарта.ВидКарты.Префикс); КонецЕсли;
                    Исключение КонецПопытки;
                    
                    ИмяКарты = ИмяКарты + СтрокаНомера;
                    
                    Попытка 
                        Если ЗначениеЗаполнено(НоваяКарта.ВидКарты.Суффикс) Тогда ИмяКарты = ИмяКарты + "-" + НоваяКарта.ВидКарты.Суффикс; КонецЕсли;
                    Исключение КонецПопытки;
                    
                    НоваяКарта.Наименование = СокрЛП(ИмяКарты);
                    // ------------------------------------------------

                    Попытка
                        НоваяКарта.Записать();
                    Исключение
                        // На случай непредвиденных проверок платформы
                        НоваяКарта.ОбменДанными.Загрузка = Истина;
                        НоваяКарта.Записать();
                    КонецПопытки;
                КонецЕсли;
            Исключение
                // Ошибку глушим, чтобы запись на прием не сорвалась
            КонецПопытки;
            // ====================================================================

            // СОЗДАНИЕ ЗАЯВКИ
            НовыйДок = Документы.Заявка.СоздатьДокумент();
            НовыйДок.Дата = ТекущаяДата();
            НовыйДок.УстановитьНовыйНомер();
            
            Попытка НовыйДок.НесколькоКабинетовИВрачей = Истина; Исключение КонецПопытки;
            Попытка НовыйДок.НесколькоВрачейИКабинетов = Истина; Исключение КонецПопытки;

            НовыйДок.Клиент = СсылкаКлиент;
            НовыйДок.Сотрудник = СсылкаСотрудник;
            НовыйДок.ДатаНачала = Начало;
            НовыйДок.ВремяНачала = Начало;
            НовыйДок.ДатаОкончания = Окончание;
            НовыйДок.ВремяОкончания = Окончание;
            НовыйДок.Филиал = Справочники.Филиалы.НайтиПоНаименованию(Данные.branch);
            
            // УМНОЕ РАСПРЕДЕЛЕНИЕ СТАТУСОВ (с защитой от ошибок)
            ИмяУслуги = НРег(Данные.service_name); 
            ИмяСтатуса = "BOT_Первичка"; // Значение по умолчанию
            Если Найти(ИмяУслуги, "первич") > 0 Тогда
                ИмяСтатуса = "BOT_Первичка";
            ИначеЕсли Найти(ИмяУслуги, "повтор") > 0 Тогда
                ИмяСтатуса = "BOT_Повторка";
            КонецЕсли;
            НайденныйСтатус = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию(ИмяСтатуса);
            НовыйДок.Состояние = ?(НайденныйСтатус.Пустая(), Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("КД"), НайденныйСтатус);
            
            ОтветственныйПользователь = Справочники.Пользователи.НайтиПоНаименованию("api_bot");
            Если НЕ ОтветственныйПользователь.Пустая() Тогда НовыйДок.Ответственный = ОтветственныйПользователь; КонецЕсли;

            // --- ДОБАВЛЕНИЕ ПРИМЕЧАНИЯ С ПРОВЕРКОЙ ПЛАТФОРМЫ ---
            Если Данные.Свойство("platform") И Данные.platform = "max" Тогда
                НовыйДок.Примечание = "Запись из MAX: " + Телефон;
            Иначе
                НовыйДок.Примечание = "Запись из Telegram: " + Телефон;
            КонецЕсли;
            // --------------------------------------------------
                        
            НоваяСтрока = НовыйДок.Работы.Добавить();
            НоваяСтрока.Сотрудник = СсылкаСотрудник;
            НоваяСтрока.Продолжительность = Дата("00010101") + ДлительностьВСекундах;
            НоваяСтрока.ДатаНачала = Начало;
            НоваяСтрока.ДатаОкончания = Окончание;
            Если НЕ СсылкаУслуга.Пустая() Тогда НоваяСтрока.Номенклатура = СсылкаУслуга; КонецЕсли;

            НовыйДок.Записать(РежимЗаписиДокумента.Запись);
            ЗафиксироватьТранзакцию(); 
            
            Результат = Новый Структура("status, appointment_id", "success", Строка(НовыйДок.Ссылка.УникальныйИдентификатор()));
            
        Исключение
            ОтменитьТранзакцию(); 
            ВызватьИсключение; 
        КонецПопытки;
        
    Исключение
        Ответ.КодСостояния = 200;
        Результат = Новый Структура("status, error", "error", "ОШИБКА 1С: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции


// =========================================================
// 2. ОТМЕНА ЗАПИСИ (CancelPOST)
// =========================================================
Функция CancelPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        IDЗаписи = Данные.appointment_id;
        
        СсылкаНаЗаявку = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(IDЗаписи));

        Если СсылкаНаЗаявку.Пустая() Тогда
            Результат = Новый Структура("status, error", "error", "Документ не найден по ID");
        Иначе
            ОбъектЗаявки = СсылкаНаЗаявку.ПолучитьОбъект();
            
            СтатусОтменена = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена");
            Если НЕ СтатусОтменена.Пустая() Тогда ОбъектЗаявки.Состояние = СтатусОтменена; КонецЕсли;
            
            ОбъектЗаявки.ПометкаУдаления = Истина;
            ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
            Результат = Новый Структура("status", "success");
        КонецЕсли;
        
    Исключение
        Результат = Новый Структура("status, error", "error", ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции


// =========================================================
// 3. ПЕРЕНОС ЗАПИСИ (ReschedulePOST)
// =========================================================
Функция ReschedulePOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        Если НЕ Данные.Свойство("old_appointment_id") ИЛИ ПустаяСтрока(Данные.old_appointment_id) Тогда
            Возврат СформироватьОтветJSON(Ответ, Новый Структура("status, error", "error", "Не передан ID старой записи"));
        КонецЕсли;

        СсылкаНаЗаявку = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.old_appointment_id));
        Если СсылкаНаЗаявку.Пустая() Тогда
            Возврат СформироватьОтветJSON(Ответ, Новый Структура("status, error", "error", "Документ для переноса не найден в 1С"));
        КонецЕсли;
        
        СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.doctor_id));
        Начало = ПарситьДату(Данные.date, Данные.time);
        Телефон = ОчиститьТелефон(Данные.patient.phone);
        
        // Перенос всегда делаем блоками по 15 минут, чтобы исключить накладки
        ДлительностьВСекундах = 1800; 
        Окончание = Начало + ДлительностьВСекундах;

        НачатьТранзакцию();
        Попытка
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлок = Блокировка.Добавить("Справочник.Сотрудники");
            ЭлементБлок.УстановитьЗначение("Ссылка", СсылкаСотрудник);
            ЭлементБлок.Режим = РежимБлокировкиДанных.Исключительный;
            Блокировка.Заблокировать(); 
            
            // ПРОВЕРКА ЗАНЯТОСТИ (исключая старую заявку)
            ЗапросПроверки = Новый Запрос;
            ЗапросПроверки.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, ДатаНачала ИЗ Документ.Заявка КАК Заявка
                |ГДЕ Заявка.Сотрудник = &Сотрудник И Заявка.ПометкаУдаления = ЛОЖЬ
                |И Заявка.Состояние <> &СтатусОтмены
                |И Заявка.Ссылка <> &ТекущаяЗаявка
                |И Заявка.ДатаНачала < &Окончание И Заявка.ДатаОкончания > &Начало";
                
            ЗапросПроверки.УстановитьПараметр("Сотрудник", СсылкаСотрудник);
            ЗапросПроверки.УстановитьПараметр("Начало", Начало);
            ЗапросПроверки.УстановитьПараметр("Окончание", Окончание);
            ЗапросПроверки.УстановитьПараметр("СтатусОтмены", Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена"));
            ЗапросПроверки.УстановитьПараметр("ТекущаяЗаявка", СсылкаНаЗаявку);
            
            РезультатЗапроса = ЗапросПроверки.Выполнить();
            Если НЕ РезультатЗапроса.Пустой() Тогда
                ОтменитьТранзакцию(); 
                БлокирующаяЗапись = РезультатЗапроса.Выгрузить()[0];
                ТекстОшибки = "Время занято! Выбранная услуга накладывается на: " + Строка(БлокирующаяЗапись.Ссылка) + " (начало в " + Формат(БлокирующаяЗапись.ДатаНачала, "ДФ=HH:mm") + ")";
                Возврат СформироватьОтветJSON(Ответ, Новый Структура("status, error", "error", ТекстОшибки));
            КонецЕсли;

            // ПЕРЕЗАПИСЬ ДОКУМЕНТА НОВЫМИ ДАННЫМИ
            ОбъектЗаявки = СсылкаНаЗаявку.ПолучитьОбъект();
            ОбъектЗаявки.Сотрудник = СсылкаСотрудник;
            ОбъектЗаявки.ДатаНачала = Начало;
            ОбъектЗаявки.ВремяНачала = Начало;
            ОбъектЗаявки.ДатаОкончания = Окончание;
            ОбъектЗаявки.ВремяОкончания = Окончание;
            ОбъектЗаявки.Филиал = Справочники.Филиалы.НайтиПоНаименованию(Данные.branch);
            ОбъектЗаявки.Примечание = "Перенос из Telegram: " + Телефон;
            
            // УМНОЕ РАСПРЕДЕЛЕНИЕ СТАТУСОВ ПРИ ПЕРЕНОСЕ
            ИмяУслуги = НРег(Данные.service_name); 
            ИмяСтатуса = "BOT_Первичка"; // Значение по умолчанию
            Если Найти(ИмяУслуги, "первич") > 0 Тогда
                ИмяСтатуса = "BOT_Первичка";
            ИначеЕсли Найти(ИмяУслуги, "повтор") > 0 Тогда
                ИмяСтатуса = "BOT_Повторка";
            КонецЕсли;
            НайденныйСтатус = Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию(ИмяСтатуса);
            ОбъектЗаявки.Состояние = ?(НайденныйСтатус.Пустая(), Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("КД"), НайденныйСтатус);
            
            ОбъектЗаявки.Работы.Очистить();
            НоваяСтрока = ОбъектЗаявки.Работы.Добавить();
            НоваяСтрока.Сотрудник = СсылкаСотрудник;
            НоваяСтрока.Продолжительность = Дата("00010101") + ДлительностьВСекундах;
            НоваяСтрока.ДатаНачала = Начало;
            НоваяСтрока.ДатаОкончания = Окончание;
            Если ЗначениеЗаполнено(Данные.service_id) Тогда
                НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.service_id)); 
            КонецЕсли;

            ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
            ЗафиксироватьТранзакцию(); 
            Результат = Новый Структура("status, appointment_id", "success", Строка(ОбъектЗаявки.Ссылка.УникальныйИдентификатор()));
            
        Исключение
            ОтменитьТранзакцию(); 
            ВызватьИсключение; 
        КонецПопытки;
        
    Исключение
        Ответ.КодСостояния = 200;
        Результат = Новый Структура("status, error", "error", "ОШИБКА 1С ПЕРЕНОС: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
КонецФункции


// =========================================================
// 4. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (Остаются без изменений)
// =========================================================
Функция ПарситьДатуРождения(СтрДР)
    Если ПустаяСтрока(СтрДР) Тогда Возврат '00010101'; КонецЕсли;
    СтрДР = СокрЛП(СтрДР);
    Попытка
        Если Найти(СтрДР, "-") > 0 Тогда 
            Возврат Дата(Число(Лев(СтрДР, 4)), Число(Сред(СтрДР, 6, 2)), Число(Прав(СтрДР, 2)));
        ИначеЕсли Найти(СтрДР, ".") > 0 Тогда 
            Возврат Дата(Число(Прав(СтрДР, 4)), Число(Сред(СтрДР, 4, 2)), Число(Лев(СтрДР, 2)));
        КонецЕсли;
    Исключение Возврат '00010101'; КонецПопытки;
    Возврат '00010101';
КонецФункции

Функция ОчиститьТелефон(Знач Стр)
    Результат = "";
    Для Поз = 1 По СтрДлина(Стр) Цикл
        Символ = Сред(Стр, Поз, 1);
        Если Найти("0123456789", Символ) > 0 Тогда Результат = Результат + Символ; КонецЕсли;
    КонецЦикла;
    Если СтрДлина(Результат) = 11 И Лев(Результат, 1) = "8" Тогда Результат = "7" + Прав(Результат, 10); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПарситьДату(СтрДата, СтрВремя)
    Возврат Дата(Число(Лев(СтрДата, 4)), Число(Сред(СтрДата, 6, 2)), Число(Прав(СтрДата, 2)), 
                Число(Лев(СтрВремя, 2)), Число(Прав(СтрВремя, 2)), 0);
КонецФункции

Функция ПрочитатьДанныеИзЗапроса(Запрос)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    ДанныеJSON = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат ДанныеJSON;
КонецФункции

Функция СформироватьОтветJSON(Ответ, СтруктураДанных)
    ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ScheduleGET(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ИДВрачаСтрока  = Запрос.ПараметрыЗапроса.Получить("doctor_id");
	ИмяФилиала     = Запрос.ПараметрыЗапроса.Получить("branch");
	ДатаСтрока     = Запрос.ПараметрыЗапроса.Получить("date");
	ДатаНачалаСтр  = Запрос.ПараметрыЗапроса.Получить("start_date");
	ДатаОкончСтр   = Запрос.ПараметрыЗапроса.Получить("end_date");
	
	Попытка
		ДатаНач = ТекущаяДата();
		ДатаКон = ТекущаяДата();
		
		// Надежная проверка на Неопределено
		Если ДатаНачалаСтр <> Неопределено И ДатаОкончСтр <> Неопределено Тогда
			ДатаНач = Дата(Число(Лев(ДатаНачалаСтр, 4)), Число(Сред(ДатаНачалаСтр, 6, 2)), Число(Прав(ДатаНачалаСтр, 2)));
			ДатаКон = Дата(Число(Лев(ДатаОкончСтр, 4)), Число(Сред(ДатаОкончСтр, 6, 2)), Число(Прав(ДатаОкончСтр, 2)));
		ИначеЕсли ДатаСтрока <> Неопределено Тогда
			ДатаНач = Дата(Число(Лев(ДатаСтрока, 4)), Число(Сред(ДатаСтрока, 6, 2)), Число(Прав(ДатаСтрока, 2)));
			ДатаКон = ДатаНач;
		КонецЕсли;

		СсылкаВрач = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДВрачаСтрока));
		СсылкаФилиал = Справочники.Филиалы.НайтиПоНаименованию(?(ИмяФилиала = Неопределено, "", ИмяФилиала));
		ИмяФилиалаНРег = НРег(?(ИмяФилиала = Неопределено, "", ИмяФилиала));
		ТекДатаСервер = ТекущаяДата(); 

		// Запрашиваем данные СРАЗУ ЗА ВЕСЬ ПЕРИОД
		ЗапросБД = Новый Запрос;
		ЗапросБД.УстановитьПараметр("Врач", СсылкаВрач);
		ЗапросБД.УстановитьПараметр("Нач", НачалоДня(ДатаНач));
		ЗапросБД.УстановитьПараметр("Кон", КонецДня(ДатаКон));
		ЗапросБД.УстановитьПараметр("Филиал", СсылкаФилиал);
		ЗапросБД.УстановитьПараметр("СтатусОтмены", Справочники.ВидыСостоянийЗаявок.НайтиПоНаименованию("Отменена"));
		
		ЗапросБД.Текст = 
			"ВЫБРАТЬ График.Дата КАК Дата, График.ВремяНачала КАК Нач, График.ВремяОкончания КАК Кон, ПРЕДСТАВЛЕНИЕ(График.ВидВремени) КАК Вид ИЗ РегистрСведений.ГрафикиРаботы КАК График 
			|ГДЕ График.Сотрудник = &Врач И График.Дата МЕЖДУ &Нач И &Кон И График.Филиал = &Филиал;
			|ВЫБРАТЬ Заявка.ДатаНачала КАК Нач, Заявка.ВремяОкончания КАК Кон ИЗ Документ.Заявка КАК Заявка 
			|ГДЕ Заявка.Сотрудник = &Врач И Заявка.ДатаНачала МЕЖДУ &Нач И &Кон И Заявка.ПометкаУдаления = ЛОЖЬ И Заявка.Состояние <> &СтатусОтмены;
			|ВЫБРАТЬ Событие.ДатаПлан КАК Нач, ДОБАВИТЬКДАТЕ(Событие.ДатаПлан, МИНУТА, 60) КАК Кон ИЗ Документ.Событие КАК Событие 
			|ГДЕ Событие.Филиал = &Филиал И Событие.ДатаПлан МЕЖДУ &Нач И &Кон И Событие.ПометкаУдаления = ЛОЖЬ"; 
			
		Пакет = ЗапросБД.ВыполнитьПакет();
		Шаг = 1800; // ЖЕСТКИЙ ШАГ 30 МИНУТ
		
		ТаблЗанятоПоДатам = Новый Соответствие;
		
		ВыбЗ = Пакет[1].Выбрать();
		Пока ВыбЗ.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыбЗ.Нач) И ЗначениеЗаполнено(ВыбЗ.Кон) Тогда
				КлючДаты = Формат(НачалоДня(ВыбЗ.Нач), "ДФ=yyyy-MM-dd");
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", Число(ВыбЗ.Нач - НачалоДня(ВыбЗ.Нач)), Число(ВыбЗ.Кон - НачалоДня(ВыбЗ.Кон))));
			КонецЕсли;
		КонецЦикла;
		
		ВыбС = Пакет[2].Выбрать();
		Пока ВыбС.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыбС.Нач) И ЗначениеЗаполнено(ВыбС.Кон) Тогда
				КлючДаты = Формат(НачалоДня(ВыбС.Нач), "ДФ=yyyy-MM-dd");
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", Число(ВыбС.Нач - НачалоДня(ВыбС.Нач)), Число(ВыбС.Кон - НачалоДня(ВыбС.Кон))));
			КонецЕсли;
		КонецЦикла;
		
		РабочиеИнтервалыПоДатам = Новый Соответствие;
		ВыбГрафик = Пакет[0].Выбрать();
		
		Пока ВыбГрафик.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыбГрафик.Нач) ИЛИ НЕ ЗначениеЗаполнено(ВыбГрафик.Кон) Тогда Продолжить; КонецЕсли;
			
			КлючДаты = Формат(НачалоДня(ВыбГрафик.Дата), "ДФ=yyyy-MM-dd");
			
			НачСек = Число(ВыбГрафик.Нач - НачалоДня(ВыбГрафик.Нач));
			КонСек = Число(ВыбГрафик.Кон - НачалоДня(ВыбГрафик.Кон));
			ВидНРег = НРег(ВыбГрафик.Вид);
			
			Если Найти(ВидНРег, "рабочее время") > 0 Тогда
				МассивРаб = РабочиеИнтервалыПоДатам.Получить(КлючДаты);
				Если МассивРаб = Неопределено Тогда МассивРаб = Новый Массив; РабочиеИнтервалыПоДатам.Вставить(КлючДаты, МассивРаб); КонецЕсли;
				МассивРаб.Добавить(Новый Структура("НачСек, КонСек", НачСек, КонСек));
			Иначе
				МассивЗанятости = ТаблЗанятоПоДатам.Получить(КлючДаты);
				Если МассивЗанятости = Неопределено Тогда МассивЗанятости = Новый Массив; ТаблЗанятоПоДатам.Вставить(КлючДаты, МассивЗанятости); КонецЕсли;
				МассивЗанятости.Добавить(Новый Структура("НачСек, КонСек", НачСек, КонСек));
			КонецЕсли;
		КонецЦикла;
		
		// --- ИСПРАВЛЕНИЕ ТУТ: Используем Соответствие, так как ключи - даты (строки с цифрами) ---
		РезультатПоДатам = Новый Соответствие; 
		
		ТекДень = НачалоДня(ДатаНач);
		Пока ТекДень <= НачалоДня(ДатаКон) Цикл
			КлючДатыТек = Формат(ТекДень, "ДФ=yyyy-MM-dd");
			
			ДеньНеделиЗапроса = ДеньНедели(ТекДень);
			КрайнееВремяВСекундах = 86400; 
			
			Если Найти(ИмяФилиалаНРег, "профсоюзная") > 0 ИЛИ Найти(ИмяФилиалаНРег, "ватутинки") > 0 Тогда
				Если ДеньНеделиЗапроса <= 5 Тогда КрайнееВремяВСекундах = 63000;
				ИначеЕсли ДеньНеделиЗапроса = 6 Тогда КрайнееВремяВСекундах = 59400;
				ИначеЕсли ДеньНеделиЗапроса = 7 Тогда КрайнееВремяВСекундах = 52200;
				КонецЕсли;
			КонецЕсли;
			
			МассивСлотовДня = Новый Массив;
			РабИнтервалыДня = РабочиеИнтервалыПоДатам.Получить(КлючДатыТек);
			ЗанИнтервалыДня = ТаблЗанятоПоДатам.Получить(КлючДатыТек);
			Если ЗанИнтервалыДня = Неопределено Тогда ЗанИнтервалыДня = Новый Массив; КонецЕсли;
			
			Если РабИнтервалыДня <> Неопределено Тогда
				Для Каждого Раб Из РабИнтервалыДня Цикл
					Тек = Раб.НачСек;
					КонецГрафика = Раб.КонСек;
					
					Пока Тек + Шаг <= КонецГрафика Цикл
						Своб = Истина; К = Тек + Шаг;
						ВремяНачала = ТекДень + Тек;
						
						Если ВремяНачала <= ТекДатаСервер ИЛИ Тек > КрайнееВремяВСекундах Тогда Своб = Ложь; КонецЕсли;
						
						Если Своб Тогда
							Для Каждого Занято Из ЗанИнтервалыДня Цикл
								Если (Тек < Занято.КонСек) И (К > Занято.НачСек) Тогда 
									Своб = Ложь; Прервать; 
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						
						Если Своб Тогда МассивСлотовДня.Добавить(Формат(ВремяНачала, "ДФ=HH:mm")); КонецЕсли;
						Тек = Тек + Шаг;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			РезультатПоДатам.Вставить(КлючДатыТек, МассивСлотовДня);
			ТекДень = ТекДень + 86400; // Следующий день
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
		ДанныеОтвета = Новый Структура("status, schedule", "success", РезультатПоДатам);
		ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"": """ + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}", КодировкаТекста.UTF8);
	КонецПопытки;
	
	Возврат Ответ;
КонецФункции


Функция PingGET(Запрос)
    
    // Создаем ответ со статусом 200 OK
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // Формируем структуру, которая превратится в JSON
    СтруктураОтвета = Новый Структура;
    СтруктураОтвета.Вставить("status", "success");
    СтруктураОтвета.Вставить("message", "1C API is running!");
    
    // Превращаем структуру в строку JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // Кладем JSON в тело ответа
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    
    Возврат Ответ;

КонецФункции

Функция SpecialtiesGET(Запрос)
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // ВАЖНО: "Справочник.Специальности" - нужно проверить, 
    // как точно называется этот справочник в вашей УМЦ (может быть "Специализации" или "Должности")
    ТекстЗапроса = 
        "ВЫБРАТЬ
        |   Специальности.Ссылка КАК Ссылка,
        |   Специальности.Наименование КАК Наименование
        |ИЗ
        |   Справочник.Специальности КАК Специальности
        |ГДЕ
        |   Специальности.ПометкаУдаления = ЛОЖЬ";
        
    ЗапросБД = Новый Запрос;
    ЗапросБД.Текст = ТекстЗапроса;
    Результат = ЗапросБД.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Собираем массив данных
    МассивДанных = Новый Массив;
    Пока Выборка.Следующий() Цикл
        ЭлементДанных = Новый Структура;
        // Превращаем GUID 1C в обычную строку
        ЭлементДанных.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
        ЭлементДанных.Вставить("name", Выборка.Наименование);
        МассивДанных.Добавить(ЭлементДанных);
    КонецЦикла;
    
    // Собираем финальный ответ
    СтруктураОтвета = Новый Структура;
    СтруктураОтвета.Вставить("status", "success");
    СтруктураОтвета.Вставить("data", МассивДанных);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
    
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    
    Возврат Ответ;

КонецФункции

Функция DoctorsGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    ИмяФилиала = СокрЛП(Запрос.ПараметрыЗапроса.Получить("branch"));
    ДатаСтрока = Запрос.ПараметрыЗапроса.Получить("date"); // Получаем дату из бота
    
    // Превращаем строку YYYY-MM-DD в дату 1С
    ДатаЗапроса = Дата(1,1,1);
    Если ЗначениеЗаполнено(ДатаСтрока) И СтрДлина(ДатаСтрока) >= 10 Тогда
        Попытка
            Год = Число(Лев(ДатаСтрока, 4));
            Месяц = Число(Сред(ДатаСтрока, 6, 2));
            День = Число(Сред(ДатаСтрока, 9, 2));
            ДатаЗапроса = Дата(Год, Месяц, День);
        Исключение
        КонецПопытки;
    КонецЕсли;

    ЗапросБД = Новый Запрос;
    
    // 1. Базовый запрос к Справочнику Сотрудников (ищем тех, у кого стоит галочка)
    ТекстЗапроса = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   Сотрудники.Ссылка КАК Ссылка,
        |   Сотрудники.Наименование КАК full_name,
        |   ПРЕДСТАВЛЕНИЕ(Сотрудники.Должность) КАК specialty_name
        |ИЗ
        |   Справочник.Сотрудники КАК Сотрудники
        |ГДЕ
        |   Сотрудники.ПометкаУдаления = ЛОЖЬ
        |   И Сотрудники.УчаствуетВОнлайнЗаписи = ИСТИНА";

    УсловиеГрафика = "";

    // 2. Если пришла дата или филиал, добавляем строгие фильтры по графику
    Если ДатаЗапроса <> Дата(1,1,1) Тогда
        УсловиеГрафика = УсловиеГрафика + " И ГрафикиРаботы.Дата = &Дата";
        ЗапросБД.УстановитьПараметр("Дата", ДатаЗапроса);
    КонецЕсли;

    Если ЗначениеЗаполнено(ИмяФилиала) Тогда
        УсловиеГрафика = УсловиеГрафика + " И ГрафикиРаботы.Филиал.Наименование ПОДОБНО &Филиал";
        ЗапросБД.УстановитьПараметр("Филиал", "%" + ИмяФилиала + "%");
    КонецЕсли;

    // Подключаем фильтр по регистру графиков, если переданы параметры
    Если СтрДлина(УсловиеГрафика) > 0 Тогда
        ТекстЗапроса = ТекстЗапроса + "
        |   И Сотрудники.Ссылка В (
        |       ВЫБРАТЬ РАЗЛИЧНЫЕ
        |           ГрафикиРаботы.Сотрудник
        |       ИЗ
        |           РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
        |       ГДЕ
        |           ИСТИНА " + УсловиеГрафика + "
        |   )";
    КонецЕсли;

    ЗапросБД.Текст = ТекстЗапроса;

    Попытка
        Выборка = ЗапросБД.Выполнить().Выбрать();
        Массив = Новый Массив;
        
        Пока Выборка.Следующий() Цикл
            // Жесткая проверка на слово "офтальмолог" удалена. 
            // Теперь бот верит твоей галочке "УчаствуетВОнлайнЗаписи".
            Сотрудник = Новый Структура("id, full_name, specialty_name");
            Сотрудник.id = Строка(Выборка.Ссылка.УникальныйИдентификатор());
            Сотрудник.full_name = Выборка.full_name;
            Сотрудник.specialty_name = Выборка.specialty_name;
            Массив.Добавить(Сотрудник);
        КонецЦикла;
        
        ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Массив);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Исключение
        Ответ.КодСостояния = 500;
        Ответ.УстановитьТелоИзСтроки("{""detail"": """ + ОписаниеОшибки() + """}", КодировкаТекста.UTF8);
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции

Функция ServicesGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Массив = Новый Массив;
    
    Попытка
        IDВрача = Запрос.ПараметрыЗапроса.Получить("doctor_id");
        ЗапросБД = Новый Запрос;
        
        // Добавляем параметр для получения актуальных цен на сегодня
        ЗапросБД.УстановитьПараметр("ТекДата", ТекущаяДата());
        
        Если ЗначениеЗаполнено(IDВрача) И IDВрача <> "undefined" И IDВрача <> "null" Тогда
            
            СсылкаСотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(IDВрача));
            ЗапросБД.УстановитьПараметр("Сотрудник", СсылкаСотрудник);
            
            ЗапросБД.Текст = 
                "ВЫБРАТЬ
                |   Регистр.Номенклатура.Ссылка КАК id,
                |   Регистр.Номенклатура.Наименование КАК name,
                |   ЕСТЬNULL(Цены.Цена, 0) КАК price
                |ИЗ
                |   РегистрСведений.ОсновныеУслугиСотрудников КАК Регистр
                |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекДата, ) КАК Цены
                |       ПО Регистр.Номенклатура = Цены.Номенклатура
                |ГДЕ
                |   Регистр.Сотрудник = &Сотрудник
                |   И Регистр.Номенклатура.ПометкаУдаления = ЛОЖЬ
                |   И Регистр.Номенклатура.ЭтоГруппа = ЛОЖЬ
                |   И Регистр.Номенклатура.УчаствуетВОнлайнЗаписи = ИСТИНА";
        Иначе
            ЗапросБД.Текст = 
                "ВЫБРАТЬ
                |   Номенклатура.Ссылка КАК id,
                |   Номенклатура.Наименование КАК name,
                |   ЕСТЬNULL(Цены.Цена, 0) КАК price
                |ИЗ
                |   Справочник.Номенклатура КАК Номенклатура
                |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекДата, ) КАК Цены
                |       ПО Номенклатура.Ссылка = Цены.Номенклатура
                |ГДЕ
                |   Номенклатура.ПометкаУдаления = ЛОЖЬ
                |   И Номенклатура.ЭтоГруппа = ЛОЖЬ
                |   И Номенклатура.УчаствуетВОнлайнЗаписи = ИСТИНА";
        КонецЕсли;
            
        Выборка = ЗапросБД.Выполнить().Выбрать();
        
        // Добавили price в формируемую структуру
        Пока Выборка.Следующий() Цикл
            Массив.Добавить(Новый Структура("id, name, price", Строка(Выборка.id.УникальныйИдентификатор()), Выборка.name, Выборка.price));
        КонецЦикла;
        
        Если Массив.Количество() = 0 Тогда
            Массив.Добавить(Новый Структура("id, name", "empty", "Нет доступных услуг для данного врача"));
        КонецЕсли;

    Исключение
        Массив.Очистить();
        Массив.Добавить(Новый Структура("id, name", "error", "ОШИБКА 1С: " + ОписаниеОшибки()));
    КонецПопытки;
    
    ЗаписьJSON = Новый ЗаписьJSON; 
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Массив);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    
    Возврат Ответ;
КонецФункции


Функция UpdateNotePOST(Запрос)
    
    // Подготовим стандартный ответ
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // 1. Читаем входящий JSON от нашего Python-бота
        // (предполагается, что ПрочитатьДанныеИзЗапроса уже есть в вашем модуле, 
        //  так как она используется в BookPOST)
        Данные = ПрочитатьДанныеИзЗапроса(Запрос);
        
        ИДЗаписи = Данные.appointment_id;
        НовыйКомментарий = Данные.note; // Сюда придет: "✅ Визит подтвержден пациентом (MAX)"
        
        // 2. Ищем документ по его УИД (уникальному идентификатору)
        УИД = Новый УникальныйИдентификатор(ИДЗаписи);
        
        // В BookPOST мы видим, что используется Документ.Заявка
        СсылкаНаДокумент = Документы.Заявка.ПолучитьСсылку(УИД); 
        
        // Проверяем, существует ли реально такой документ
        Если СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
            Результат = Новый Структура("status, error", "error", "Документ не найден в 1С");
            Ответ.КодСостояния = 404;
            Возврат СформироватьОтветJSON(Ответ, Результат);
        КонецЕсли;
        
        // 3. Блокируем объект для изменения и пишем комментарий
        ОбъектДок = СсылкаНаДокумент.ПолучитьОбъект();
        
        // Дописываем наш текст с новой строки в ПРИМЕЧАНИЕ
        // (чтобы не затереть то, что уже было, например "Запись из MAX: +7 999...")
        Если ПустаяСтрока(ОбъектДок.Примечание) Тогда
            ОбъектДок.Примечание = НовыйКомментарий;
        Иначе
            // Получится: 
            // ✅ Визит подтвержден пациентом (MAX)
            // Запись из MAX: +7 999 123-45-67
            ОбъектДок.Примечание = НовыйКомментарий + Символы.ПС + ОбъектДок.Примечание;
        КонецЕсли;
        
        // Записываем документ в базу
        ОбъектДок.Записать(РежимЗаписиДокумента.Запись);
        
        // 4. Отвечаем боту, что всё супер
        Результат = Новый Структура("status", "success");
        
    Исключение
        Ответ.КодСостояния = 500;
        Результат = Новый Структура("status, error", "error", "ОШИБКА 1С: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат СформироватьОтветJSON(Ответ, Результат);
    
КонецФункции

