# Пример настроек Telegram-бота. Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ---
BOT_TOKEN=
# Адрес Bot API. В проде — посредник Cloudflare Worker (без /bot<токен> в конце)
TELEGRAM_API_BASE=https://api.telegram.org
# Секрет вебхука Telegram (setWebhook secret_token): 1-256 символов A-Za-z0-9_-
TG_WEBHOOK_SECRET=
# id администраторов для команды /stats, через запятую
ADMIN_IDS=

# --- WebApp ---
WEBAPP_URL=https://1cmed.one-two.online
WEBAPP_URL2=https://yasno-vizhu.com
PD_POLICY_URL=https://yasno-vizhu.com/docs/Согласие_на_обработку_персональных_данных.pdf
# Срок жизни данных запуска формы, часов
INIT_DATA_MAX_AGE_HOURS=24

# --- 1С УМЦ ---
ONEC_URL=
ONEC_USER=
ONEC_PASSWORD=
# Секрет, который 1С передаёт в заголовке X-Bot-Secret (свой для каждого бота)
ONEC_WEBHOOK_SECRET=

# --- Админка ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Хранение и служебное ---
PD_RETENTION_DAYS=30
DB_PATH=appointments.db
LOG_DIR=logs
HOST=127.0.0.1
PORT=8001
