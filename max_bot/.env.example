# Пример настроек MAX-бота. Скопируйте в .env и заполните. .env в git не попадает.

# --- MAX ---
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Секрет вебхука MAX (POST /subscriptions secret): 5-256 символов A-Za-z0-9_-
MAX_WEBHOOK_SECRET=
# Мини-приложение для кнопки open_app (ник бота или ссылка, как задано в кабинете MAX)
MAX_MINIAPP=
ADMIN_IDS=

# --- WebApp ---
WEBAPP_URL=https://1cmed.one-two.online
PD_POLICY_URL=https://yasno-vizhu.com/docs/Согласие_на_обработку_персональных_данных.pdf
INIT_DATA_MAX_AGE_HOURS=24

# --- 1С УМЦ ---
ONEC_URL=
ONEC_USER=
ONEC_PASSWORD=
ONEC_WEBHOOK_SECRET=

# --- Админка ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Хранение и служебное ---
PD_RETENTION_DAYS=30
DB_PATH=max_appointments.db
LOG_DIR=logs
HOST=127.0.0.1
PORT=8002
